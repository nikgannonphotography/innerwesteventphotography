  function initQuoteBuilder() {
    const element = document.querySelector<HTMLElement>(".quote-builder_wrap");
    if (!element) return;
    const wrap: HTMLElement = element;

    // Elements
    const sectorCards = wrap.querySelectorAll<HTMLLabelElement>(".quote-builder_grid-sectors .quote-builder_sector-card");
    const typesContainer = wrap.querySelector<HTMLElement>("#qb-types-container");
    const weddingScaleSection = wrap.querySelector<HTMLElement>("#qb-step-wedding-scale");
    const weddingScaleCards = wrap.querySelectorAll<HTMLLabelElement>(".quote-builder_grid-wedding-scale .quote-builder_card");
    const durationCardsContainer = wrap.querySelector<HTMLElement>("#qb-duration-cards-container");
    const pillsContainer = wrap.querySelector<HTMLElement>("#qb-pills-container");
    const rangeInput = wrap.querySelector<HTMLInputElement>("#qb-range-input");
    const hoursDisplay = wrap.querySelector<HTMLElement>("#qb-hours-display");
    const photosEstimate = wrap.querySelector<HTMLElement>("#qb-photos-estimate");
    const scopeSuggestion = wrap.querySelector<HTMLElement>("#qb-scope-suggestion");
    const crewOptions = wrap.querySelectorAll<HTMLInputElement>("input[name='qb_crew']");
    const secondCostDisplay = wrap.querySelector<HTMLElement>("#qb-second-cost");
    const turnaroundOptions = wrap.querySelectorAll<HTMLInputElement>("input[name='qb_turnaround']");
    const addonStudio = wrap.querySelector<HTMLInputElement>("#qb-addon-studio");
    const addonSponsor = wrap.querySelector<HTMLInputElement>("#qb-addon-sponsor");
    const valueBannerText = wrap.querySelector<HTMLElement>("#qb-value-banner-text");
    
    // Outputs & Summary
    const totalPriceEl = wrap.querySelector<HTMLElement>("#qb-total-price");
    const breakdownList = wrap.querySelector<HTMLUListElement>("#qb-breakdown-list");
    const copyBtn = wrap.querySelector<HTMLButtonElement>("#qb-btn-copy");
    const copyText = wrap.querySelector<HTMLElement>("#qb-copy-text");

    // Hidden form fields
    const hiddenSummary = wrap.querySelector<HTMLInputElement>("#qb-hidden-summary");
    const hiddenTotal = wrap.querySelector<HTMLInputElement>("#qb-hidden-total");
    const hiddenHours = wrap.querySelector<HTMLInputElement>("#qb-hidden-hours");
    const hiddenType = wrap.querySelector<HTMLInputElement>("#qb-hidden-type");

    let currentSector = "business";
    let selectedEventType = "corporate";
    let selectedWeddingLane = "micro";
    let eventTypeLabel = "Corporate Conferences, Summits & Galas";
    let eventDiscount = 1.0; // 0.9 for NFP
    let eventDiscountLabel = "";
    let currentHours = 8;

    function renderStep2Types(sectorKey: string) {
      if (!typesContainer) return;
      const options = SECTOR_TYPES[sectorKey] || SECTOR_TYPES.business;

      typesContainer.innerHTML = options
        .map((opt, idx) => {
          const isSelected = idx === 0;
          if (isSelected) {
            selectedEventType = opt.id;
            eventTypeLabel = opt.label;
            eventDiscount = opt.baseMult;
            eventDiscountLabel = opt.discountLabel || "";
          }
          return `
            <label class="quote-builder_card ${isSelected ? "is-selected" : ""}" data-type-id="${opt.id}" data-base-mult="${opt.baseMult}" data-discount-label="${opt.discountLabel || ""}" data-label="${opt.label}">
              <input type="radio" name="qb_event_type" value="${opt.id}" ${isSelected ? "checked" : ""} class="quote-builder_sr-only" />
              <span class="quote-builder_card-header">
                <span class="quote-builder_card-title">${opt.title}</span>
                ${opt.badge ? `<span class="quote-builder_badge ${opt.badgeAccent ? "quote-builder_badge-accent" : ""}">${opt.badge}</span>` : ""}
              </span>
              <span class="quote-builder_card-desc">${opt.desc}</span>
            </label>
          `;
        })
        .join("");

      // Bind click events on Step 2 cards
      typesContainer.querySelectorAll<HTMLLabelElement>(".quote-builder_card").forEach((card) => {
        const input = card.querySelector<HTMLInputElement>("input[type='radio']");
        card.addEventListener("click", () => {
          typesContainer.querySelectorAll(".quote-builder_card").forEach((c) => c.classList.remove("is-selected"));
          card.classList.add("is-selected");
          if (input) input.checked = true;

          selectedEventType = card.dataset.typeId || "corporate";
          eventTypeLabel = card.dataset.label || "Corporate Event";
          eventDiscount = Number(card.dataset.baseMult || "1.0");
          eventDiscountLabel = card.dataset.discountLabel || "";

          handleTypeChanged();
        });
      });

      handleTypeChanged();
    }

    function handleTypeChanged() {
      // Toggle Wedding Scale sub-step
      const isWedding = selectedEventType === "weddings";
      if (weddingScaleSection) {
        weddingScaleSection.style.display = isWedding ? "flex" : "none";
      }

      // Update active package category key
      let packageKey = selectedEventType;
      if (isWedding) {
        packageKey = `weddings_${selectedWeddingLane}`;
      }

      renderDynamicPills(selectedEventType);
      renderDynamicDurationCards(packageKey);

      // Set default hours based on selected type
      if (isWedding) {
        if (selectedWeddingLane === "micro") currentHours = 4;
        else if (selectedWeddingLane === "classic") currentHours = 8;
        else if (selectedWeddingLane === "multiday") currentHours = 14;
      } else if (selectedEventType === "portraits") {
        currentHours = 2;
      } else {
        currentHours = 8;
      }

      syncDurationUI(currentHours);
      calculateTotal();
    }

    function renderDynamicPills(category: string) {
      if (!pillsContainer) return;
      const isWedding = category === "weddings";
      
      let pillData: { hours: number; label: string; price: number }[] = [];
      if (isWedding) {
        pillData = [
          { hours: 2, label: "2h (Elopement)", price: 850 },
          { hours: 3, label: "3h", price: 1180 },
          { hours: 4, label: "4h (Micro)", price: 1500 },
          { hours: 5, label: "5h", price: 1825 },
          { hours: 6, label: "6h (Boutique)", price: 2150 },
          { hours: 7, label: "7h", price: 2475 },
          { hours: 8, label: "8h (Classic)", price: 2800 },
          { hours: 9, label: "9h", price: 3125 },
          { hours: 10, label: "10h (Grand)", price: 3450 },
          { hours: 12, label: "12h", price: 4100 },
          { hours: 14, label: "2-Day (14h)", price: 4800 },
        ];
      } else {
        pillData = [
          { hours: 2, label: "2h", price: 500 },
          { hours: 3, label: "3h", price: 680 },
          { hours: 4, label: "4h (Half)", price: 850 },
          { hours: 5, label: "5h", price: 1000 },
          { hours: 6, label: "6h", price: 1150 },
          { hours: 7, label: "7h", price: 1225 },
          { hours: 8, label: "8h (Full)", price: 1300 },
          { hours: 9, label: "9h", price: 1475 },
          { hours: 10, label: "10h (Gala)", price: 1650 },
          { hours: 12, label: "12h", price: 1980 },
          { hours: 20, label: "2-Day (20h)", price: 3250 },
        ];
      }

      pillsContainer.innerHTML = pillData
        .map(
          (p) => `
          <button type="button" class="quote-builder_pill ${p.hours === currentHours ? "is-active" : ""}" data-hours="${p.hours}">
            ${p.label} <span class="quote-builder_pill-price">$${p.price.toLocaleString("en-AU")}</span>
          </button>
        `
        )
        .join("");

      pillsContainer.querySelectorAll<HTMLButtonElement>(".quote-builder_pill").forEach((pill) => {
        pill.addEventListener("click", () => {
          const hrs = Number(pill.dataset.hours || 8);
          syncDurationUI(hrs);
          calculateTotal();
        });
      });
    }

    function renderDynamicDurationCards(packageKey: string) {
      if (!durationCardsContainer) return;
      if (selectedEventType === "portraits") {
        durationCardsContainer.innerHTML = "";
        return;
      }
      const packages = CATEGORY_PACKAGES[packageKey] || CATEGORY_PACKAGES.corporate;

      durationCardsContainer.innerHTML = packages
        .map((pkg) => {
          const isSelected = pkg.hours === currentHours;
          const isMultiDay = pkg.hours === 20 || pkg.hours === 14 || pkg.hours === 12;
          return `
            <div class="quote-builder_duration-card ${pkg.isPopular ? "is-popular" : ""} ${isSelected ? "is-selected" : ""}" data-card-hours="${pkg.hours}">
              <div class="quote-builder_duration-card-top">
                <span class="quote-builder_badge ${pkg.badgeAccent ? "quote-builder_badge-accent" : ""}">${pkg.badge || ""}</span>
                <span class="quote-builder_duration-price">$${pkg.price.toLocaleString("en-AU")}</span>
              </div>
              <h3 class="quote-builder_duration-name text-style-h6">${pkg.name}</h3>
              <span class="quote-builder_duration-rate text-style-small">${pkg.rateDesc}</span>
              <p class="quote-builder_duration-desc text-style-small">${pkg.desc}</p>
              ${pkg.savings ? `<div class="quote-builder_duration-savings text-style-small">${pkg.savings}</div>` : ""}
              <button type="button" class="quote-builder_duration-btn" data-hours="${pkg.hours}">
                ${isSelected ? `Selected (${isMultiDay ? "Multi-Day" : pkg.hours + "h"})` : `Select ${isMultiDay ? "Multi-Day" : pkg.hours + "h Package"}`}
              </button>
            </div>
          `;
        })
        .join("");

      // Bind click events on newly rendered cards
      const newCards = durationCardsContainer.querySelectorAll<HTMLElement>(".quote-builder_duration-card");
      newCards.forEach((card) => {
        const hrs = Number(card.dataset.cardHours || 8);
        const handleCardClick = () => {
          syncDurationUI(hrs);
          calculateTotal();
        };
        card.addEventListener("click", handleCardClick);
        card.querySelector(".quote-builder_duration-btn")?.addEventListener("click", (e) => {
          e.stopPropagation();
          handleCardClick();
        });
      });
    }

    function syncDurationUI(hours: number) {
      currentHours = hours;

      // Sync Duration Cards
      const currentCards = wrap.querySelectorAll<HTMLElement>(".quote-builder_duration-card");
      currentCards.forEach((card) => {
        const cardHrs = Number(card.dataset.cardHours);
        const btn = card.querySelector<HTMLButtonElement>(".quote-builder_duration-btn");
        const isMulti = cardHrs === 20 || cardHrs === 14 || cardHrs === 12;

        if (cardHrs === currentHours) {
          card.classList.add("is-selected");
          if (btn) {
            btn.textContent = `Selected (${isMulti ? "Multi-Day" : cardHrs + "h"})`;
          }
        } else {
          card.classList.remove("is-selected");
          if (btn) {
            btn.textContent = `Select ${isMulti ? "Multi-Day" : cardHrs + "h Package"}`;
          }
        }
      });

      // Sync Quick Pills
      const activePills = wrap.querySelectorAll<HTMLButtonElement>(".quote-builder_pills .quote-builder_pill");
      activePills.forEach((p) => {
        const pillHrs = Number(p.dataset.hours);
        if (pillHrs === currentHours) {
          p.classList.add("is-active");
        } else {
          p.classList.remove("is-active");
        }
      });

      // Sync Slider
      if (rangeInput) {
        if (currentHours === 20 || currentHours === 14) {
          rangeInput.value = "10";
        } else {
          rangeInput.value = String(Math.min(12, Math.max(2, currentHours)));
        }
      }
    }

    function calculateTotal() {
      const isWedding = selectedEventType === "weddings";

      // 1. Base price from hours (dedicated wedding rates vs standard event rates)
      let baseRate = 0;
      if (isWedding) {
        baseRate = WEDDING_PRICING_TABLE[currentHours] || (2800 + (currentHours - 8) * 325);
      } else {
        baseRate = PRICING_TABLE[currentHours] || (1300 + (currentHours - 8) * 160);
      }
      
      // 2. Second shooter
      let secondShooterCost = 0;
      const isDoubleCrew = Array.from(crewOptions).find(r => r.checked)?.value === "double";
      
      let secondRate = isWedding ? SECOND_SHOOTER_RATES.weddingFullDay : SECOND_SHOOTER_RATES.fullDay;
      if (currentHours <= 4) {
        secondRate = isWedding ? SECOND_SHOOTER_RATES.weddingHalfDay : SECOND_SHOOTER_RATES.halfDay;
      } else if (currentHours === 20 || currentHours === 14) {
        secondRate = isWedding ? SECOND_SHOOTER_RATES.weddingMultiDay : SECOND_SHOOTER_RATES.multiDay;
      }

      if (secondCostDisplay) {
        secondCostDisplay.textContent = (currentHours === 20 || currentHours === 14) 
          ? `+ $${secondRate} (2 Days)` 
          : `+ $${secondRate}`;
      }
      if (isDoubleCrew) {
        secondShooterCost = secondRate;
      }

      // 3. Turnaround
      let turnaroundCost = 0;
      let turnaroundLabel = isWedding ? "Standard Delivery (2–3 Weeks)" : "Standard 3–5 Day Delivery";
      const selectedTurnaround = Array.from(turnaroundOptions).find(r => r.checked);
      if (selectedTurnaround) {
        const optionWrapper = selectedTurnaround.closest(".quote-builder_option") as HTMLElement;
        turnaroundCost = Number(optionWrapper?.dataset.turnaroundCost || 0);
        if (selectedTurnaround.value === "nextday") {
          turnaroundLabel = isWedding ? "Next-Day Sneak Peek Highlights" : "Next-Day Priority Selects";
        }
        if (selectedTurnaround.value === "sameday") turnaroundLabel = "Same-Day / Live PR Dispatch";
      }

      // 4. Addons
      let addonCost = 0;
      let hasStudio = addonStudio?.checked || false;
      let hasSponsor = addonSponsor?.checked || false;
      if (hasStudio) addonCost += 250;
      if (hasSponsor) addonCost += 200;

      // 5. Category discount / modifier (e.g. 10% NFP discount)
      let discountAmount = 0;
      let subtotal = baseRate + secondShooterCost + turnaroundCost + addonCost;
      if (eventDiscount < 1.0) {
        discountAmount = Math.round(subtotal * (1 - eventDiscount));
      }
      let finalTotal = subtotal - discountAmount;

      // Render Total
      if (totalPriceEl) {
        totalPriceEl.textContent = finalTotal.toLocaleString("en-AU");
      }

      // Render Outputs & Breakdown
      if (hoursDisplay) {
        if (currentHours === 20) {
          hoursDisplay.textContent = "20 (2 Days @ 10h)";
        } else if (currentHours === 14) {
          hoursDisplay.textContent = "14 (2-Day Cultural Wedding)";
        } else {
          hoursDisplay.textContent = String(currentHours);
        }
      }
      
      const scopeData = isWedding 
        ? (WEDDING_SCOPE_SUGGESTIONS[currentHours] || { photos: `~${currentHours * 75}–${currentHours * 100} fine-art images`, desc: "Custom wedding coverage" })
        : (SCOPE_SUGGESTIONS[currentHours] || { photos: `~${currentHours * 60}–${currentHours * 80} edited high-res images`, desc: "Custom event coverage scope" });

      if (photosEstimate) {
        photosEstimate.textContent = scopeData.photos;
      }
      if (scopeSuggestion) {
        scopeSuggestion.textContent = scopeData.desc;
      }

      // Value banner update
      if (valueBannerText) {
        if (isWedding) {
          valueBannerText.innerHTML = `<strong>Dedicated Documentary Wedding Coverage:</strong> Deal directly with principal photographer Nikolas Gannon. Includes pre-wedding run-sheet consultation, fine-art skin tone colour grading, private high-res digital gallery &amp; full personal printing rights.`;
        } else if (selectedEventType === "birthdays" || selectedEventType === "milestones") {
          valueBannerText.innerHTML = `<strong>Birthdays &amp; Private Celebrations:</strong> Professional, candid photography for birthdays, family celebrations, baptisms, christenings, and private parties. High-res print &amp; web files included.`;
        } else if (eventDiscount < 1.0) {
          valueBannerText.innerHTML = `<strong>Community Courtesy Benefit:</strong> Dedicated 10% courtesy discount applied for registered charities, foundations, and community forums. High-res print + web files included.`;
        } else {
          valueBannerText.innerHTML = `<strong>Direct Principal Photographer Coverage:</strong> Deal directly with senior principal photographer Nikolas Gannon. No middleman agency markups. $10M Public Liability Insurance &amp; full commercial licence included.`;
        }
      }

      // Build breakdown HTML
      const lines: { name: string; val: string; isDiscount?: boolean }[] = [];
      let coverageLineName = `${currentHours} Hours Coverage (${eventTypeLabel})`;
      if (currentHours === 20) {
        coverageLineName = `2-Day Summit Coverage (20h / 2x 10h Days)`;
      } else if (currentHours === 14 && isWedding) {
        coverageLineName = `2-Day Cultural Wedding (14 Hours)`;
      }

      lines.push({
        name: coverageLineName,
        val: `$${baseRate.toLocaleString("en-AU")}`,
      });

      lines.push({
        name: isDoubleCrew 
          ? ((currentHours === 20 || currentHours === 14) ? "2x Photographers (2 Full Days)" : "2x Photographers (Lead + Second)")
          : "1x Lead Photographer",
        val: isDoubleCrew ? `+$${secondShooterCost}` : "Included",
      });

      if (turnaroundCost > 0) {
        lines.push({
          name: turnaroundLabel,
          val: `+$${turnaroundCost}`,
        });
      } else {
        lines.push({
          name: turnaroundLabel,
          val: "$0",
        });
      }

      if (hasStudio) {
        lines.push({ name: "Mobile Studio & Lighting Setup", val: "+$250" });
      }
      if (hasSponsor) {
        lines.push({ name: "Commercial Sponsor Rights", val: "+$200" });
      }

      if (discountAmount > 0) {
        lines.push({
          name: eventDiscountLabel || "10% Community Courtesy Benefit",
          val: `-$${discountAmount}`,
          isDiscount: true,
        });
      }

      if (breakdownList) {
        breakdownList.innerHTML = lines
          .map(
            (l) =>
              `<li class="quote-builder_line-item ${l.isDiscount ? "is-discount" : ""}">
                <span class="quote-builder_line-name">${l.name}</span>
                <span class="quote-builder_line-val">${l.val}</span>
              </li>`
          )
          .join("");
      }

      // Update hidden form inputs
      const summaryText = [
        `=== IWEP QUOTE BUILDER ESTIMATE ===`,
        `Sector: ${currentSector === "business" ? "Business & Corporate" : (currentSector === "nfp" ? "Not-For-Profit / Charity" : "Personal & Private Celebrations")}`,
        `Event Type: ${eventTypeLabel}`,
        `Coverage: ${coverageLineName}`,
        `Photographers: ${isDoubleCrew ? "2 Photographers (Lead + Second)" : "1 Lead Photographer"}`,
        `Turnaround: ${turnaroundLabel}`,
        hasStudio ? `Add-on: Mobile Studio Lighting & Backdrop (+$250)` : ``,
        hasSponsor ? `Add-on: Commercial Sponsor Rights Package (+$200)` : ``,
        discountAmount > 0 ? `Courtesy Benefit: -AU$${discountAmount} (${eventDiscountLabel})` : ``,
        `Estimated Total Investment: AU$${finalTotal.toLocaleString("en-AU")}`,
      ]
        .filter(Boolean)
        .join("\n");

      if (hiddenSummary) hiddenSummary.value = summaryText;
      if (hiddenTotal) hiddenTotal.value = `AU$${finalTotal.toLocaleString("en-AU")}`;
      if (hiddenHours) hiddenHours.value = currentHours === 20 ? "2-Day Summit (20h)" : (currentHours === 14 ? "2-Day Wedding (14h)" : `${currentHours} Hours`);
      if (hiddenType) hiddenType.value = eventTypeLabel;

      return { finalTotal, summaryText };
    }

    // Step 1: Sector selection
    sectorCards.forEach((card) => {
      const input = card.querySelector<HTMLInputElement>("input[type='radio']");
      card.addEventListener("click", () => {
        sectorCards.forEach((c) => c.classList.remove("is-selected"));
        card.classList.add("is-selected");
        if (input) input.checked = true;

        currentSector = card.dataset.sector || "business";
        renderStep2Types(currentSector);
      });
    });

    // Step 2.5: Wedding Scale selection
    weddingScaleCards.forEach((card) => {
      const input = card.querySelector<HTMLInputElement>("input[type='radio']");
      card.addEventListener("click", () => {
        weddingScaleCards.forEach((c) => c.classList.remove("is-selected"));
        card.classList.add("is-selected");
        if (input) input.checked = true;

        selectedWeddingLane = card.dataset.weddingLane || "micro";
        renderDynamicDurationCards(`weddings_${selectedWeddingLane}`);
        
        if (selectedWeddingLane === "micro") currentHours = 4;
        else if (selectedWeddingLane === "classic") currentHours = 8;
        else if (selectedWeddingLane === "multiday") currentHours = 14;

        syncDurationUI(currentHours);
        calculateTotal();
      });
    });

    // Range Slider
    if (rangeInput) {
      rangeInput.addEventListener("input", () => {
        const hrs = Number(rangeInput.value);
        syncDurationUI(hrs);
        calculateTotal();
      });
    }

    // Crew Selection
    crewOptions.forEach((crew) => {
      crew.addEventListener("change", () => {
        wrap.querySelectorAll(".quote-builder_grid-2 .quote-builder_option").forEach((opt) => {
          opt.classList.remove("is-selected");
        });
        const parent = crew.closest(".quote-builder_option");
        if (parent) parent.classList.add("is-selected");
        calculateTotal();
      });
    });

    // Turnaround Selection
    turnaroundOptions.forEach((turnaround) => {
      turnaround.addEventListener("change", () => {
        wrap.querySelectorAll(".quote-builder_grid-turnaround .quote-builder_option").forEach((opt) => {
          opt.classList.remove("is-selected");
        });
        const parent = turnaround.closest(".quote-builder_option");
        if (parent) parent.classList.add("is-selected");
        calculateTotal();
      });
    });

    // Add-on checkboxes
    [addonStudio, addonSponsor].forEach((addon) => {
      addon?.addEventListener("change", () => {
        const parent = addon.closest(".quote-builder_check-option");
        if (parent) {
          if (addon.checked) {
            parent.classList.add("is-checked");
          } else {
            parent.classList.remove("is-checked");
          }
        }
        calculateTotal();
      });
    });

    // Copy Summary Button
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const { summaryText } = calculateTotal();
        try {
          await navigator.clipboard.writeText(summaryText);
          if (copyText) copyText.textContent = "✓ Copied to Clipboard!";
          setTimeout(() => {
            if (copyText) copyText.textContent = "Copy Quote Summary";
          }, 2500);
        } catch (err) {
          console.error("Clipboard copy failed", err);
        }
      });
    }

    // Smooth scroll for Enquire button
    const enquireBtn = wrap.querySelector<HTMLAnchorElement>("#qb-btn-enquire");
    enquireBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      const target = document.querySelector("#qb-enquiry");
      if (target) {
        target.scrollIntoView({ behavior: "smooth" });
        const firstField = target.querySelector<HTMLInputElement>("#qb-name");
        firstField?.focus();
      }
    });

    // Form Submission (HubSpot CRM & Formspree)
    const form = wrap.querySelector<HTMLFormElement>("#qb-inquiry-form");
    const submitBtn = wrap.querySelector<HTMLButtonElement>("#qb-submit-btn");
    const successMsg = wrap.querySelector<HTMLElement>("#qb-form-success");
    const errorMsg = wrap.querySelector<HTMLElement>("#qb-form-error");

    form?.addEventListener("submit", async (e) => {
      if (!form.checkValidity()) return;
      e.preventDefault();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Submitting Quote Enquiry...";
      }
      if (successMsg) successMsg.style.display = "none";
      if (errorMsg) errorMsg.style.display = "none";

      const formData = new FormData(form);
      const fullName = String(formData.get("fullName") || "").trim();
      const nameParts = fullName.split(/\s+/);
      const firstname = nameParts[0] || "";
      const lastname = nameParts.slice(1).join(" ") || firstname;
      const email = String(formData.get("email") || "");
      const phone = String(formData.get("phone") || "");
      const company = String(formData.get("organisation") || "");
      const eventDate = String(formData.get("eventDate") || "");
      const venue = String(formData.get("venue") || "");
      const userMessage = String(formData.get("message") || "");
      const quoteSummary = String(formData.get("calculatedQuoteSummary") || "");

      const fullCrmMessage = [
        quoteSummary,
        `--- Client Event Details ---`,
        `Event Date: ${eventDate}`,
        `Venue: ${venue}`,
        userMessage ? `\nClient Notes & Scope:\n${userMessage}` : ``,
      ]
        .filter(Boolean)
        .join("\n");

      const hubspotPortalId = form.dataset.hubspotPortal;
      const hubspotFormId = form.dataset.hubspotForm;
      const hubspotRegion = form.dataset.hubspotRegion || "ap1";

      try {
        let sent = false;

        // Try HubSpot native submission
        if (hubspotPortalId && hubspotFormId) {
          const hubspotPayload = {
            fields: [
              { name: "firstname", value: firstname },
              { name: "lastname", value: lastname },
              { name: "email", value: email },
              { name: "phone", value: phone },
              { name: "company", value: company },
              { name: "message", value: fullCrmMessage },
            ],
            context: {
              pageUri: window.location.href,
              pageName: "Quote Builder - " + document.title,
            },
          };

          const endpoint = `https://api-${hubspotRegion}.hsforms.com/submissions/v3/integration/submit/${hubspotPortalId}/${hubspotFormId}`;
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(hubspotPayload),
          });

          if (res.ok) {
            sent = true;
          }
        }

        // Backup to Formspree endpoint
        if (!sent && form.action) {
          const formspreeRes = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: { Accept: "application/json" },
          });
          if (formspreeRes.ok) {
            sent = true;
          }
        }

        if (sent) {
          if (successMsg) successMsg.style.display = "block";
          form.reset();
          calculateTotal();
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Quote Request Sent ✓";
          }
        } else {
          throw new Error("Submission not completed");
        }
      } catch (err) {
        console.error(err);
        if (errorMsg) errorMsg.style.display = "block";
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit Quote & Check Availability →";
        }
      }
    });

    // Initial render
    renderStep2Types("business");
  }

  // Initialize on load and on client-side navigation
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initQuoteBuilder);
  } else {
    initQuoteBuilder();
  }
  document.addEventListener("astro:page-load", initQuoteBuilder);
</script>

