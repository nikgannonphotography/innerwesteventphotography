---
import type { HTMLAttributes } from "astro/types";
import { STUDIO_CONTACT, HUBSPOT_CONFIG } from "@/consts.ts";
import Icon from "@/components/Media/Icon.astro";
import checkIcon from "@/assets/icons/check.svg";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <div class:list={["quote-builder_wrap", className]} {...rest}>
      <div class="quote-builder_layout">
        <!-- Configuration Column -->
        <div class="quote-builder_config">
          
          <!-- Funnel Step 1: Sector Intent Selection -->
          <div class="quote-builder_section" id="qb-step-sector">
            <div class="quote-builder_section-header">
              <span class="quote-builder_step-number">01</span>
              <div>
                <h2 class="quote-builder_step-title text-style-h4">What kind of event?</h2>
                <p class="quote-builder_step-desc text-style-small">Select an option to see relevant packages and pricing.</p>
              </div>
            </div>

            <div class="quote-builder_grid quote-builder_grid-sectors" role="radiogroup" aria-label="Sector selection">
              <!-- Sector: Business / Corporate -->
              <label class="quote-builder_card quote-builder_sector-card is-selected" data-sector="business">
                <input type="radio" name="qb_sector" value="business" checked class="quote-builder_sr-only" />
                <span class="quote-builder_card-icon">🏢</span>
                <span class="quote-builder_card-title">Business</span>
                <span class="quote-builder_card-desc">Conferences, events, launches, and headshots.</span>
              </label>

              <!-- Sector: Not-For-Profit / Charity -->
              <label class="quote-builder_card quote-builder_sector-card" data-sector="nfp">
                <input type="radio" name="qb_sector" value="nfp" class="quote-builder_sr-only" />
                <span class="quote-builder_card-icon">🤝</span>
                <span class="quote-builder_card-header">
                  <span class="quote-builder_card-title">Not-For-Profit</span>
                  <span class="quote-builder_badge">10% Courtesy</span>
                </span>
                <span class="quote-builder_card-desc">Charity galas, community events, and forums.</span>
              </label>

              <!-- Sector: Personal / Private -->
              <label class="quote-builder_card quote-builder_sector-card" data-sector="personal">
                <input type="radio" name="qb_sector" value="personal" class="quote-builder_sr-only" />
                <span class="quote-builder_card-icon">🎉</span>
                <span class="quote-builder_card-title">Personal</span>
                <span class="quote-builder_card-desc">Weddings, parties, and family celebrations.</span>
              </label>
            </div>
          </div>

          <!-- Funnel Step 2: Specific Event Type (Filtered by Sector) -->
          <div class="quote-builder_section" id="qb-step-type">
            <div class="quote-builder_section-header">
              <span class="quote-builder_step-number">02</span>
              <div>
                <h2 class="quote-builder_step-title text-style-h4">Event category</h2>
                <p class="quote-builder_step-desc text-style-small">Pick the option that best fits your event.</p>
              </div>
            </div>

            <div class="quote-builder_grid quote-builder_grid-types" id="qb-types-container" role="radiogroup" aria-label="Event category selection">
              <!-- Dynamically populated via JS based on selected sector -->
            </div>
          </div>

          <!-- Funnel Step 2.5: Wedding Scale Sub-Branch (Only shown for Weddings & Elopements) -->
          <div class="quote-builder_section" id="qb-step-wedding-scale" style="display: none;">
            <div class="quote-builder_section-header">
              <span class="quote-builder_step-number">02B</span>
              <div>
                <h2 class="quote-builder_step-title text-style-h4">Wedding size</h2>
                <p class="quote-builder_step-desc text-style-small">Select the scale of your wedding day.</p>
              </div>
            </div>

            <div class="quote-builder_grid quote-builder_grid-wedding-scale" role="radiogroup" aria-label="Wedding scale selection">
              <label class="quote-builder_card is-selected" data-wedding-lane="micro">
                <input type="radio" name="qb_wedding_scale" value="micro" checked class="quote-builder_sr-only" />
                <span class="quote-builder_card-header">
                  <span class="quote-builder_card-title">🌿 Elopement / Micro-Wedding</span>
                  <span class="quote-builder_badge">2–4 Hours</span>
                </span>
                <span class="quote-builder_card-desc">Ceremony, family photos, and portraits (up to 40 guests).</span>
              </label>

              <label class="quote-builder_card" data-wedding-lane="classic">
                <input type="radio" name="qb_wedding_scale" value="classic" class="quote-builder_sr-only" />
                <span class="quote-builder_card-header">
                  <span class="quote-builder_card-title">👰 Full-Day Wedding</span>
                  <span class="quote-builder_badge quote-builder_badge-accent">6–10 Hours</span>
                </span>
                <span class="quote-builder_card-desc">Getting ready through to the ceremony, reception, and party.</span>
              </label>

              <label class="quote-builder_card" data-wedding-lane="multiday">
                <input type="radio" name="qb_wedding_scale" value="multiday" class="quote-builder_sr-only" />
                <span class="quote-builder_card-header">
                  <span class="quote-builder_card-title">🎊 Multi-Day Wedding</span>
                  <span class="quote-builder_badge">14+ Hours (2 Days)</span>
                </span>
                <span class="quote-builder_card-desc">Two days of coverage for multi-part or cultural weddings.</span>
              </label>
            </div>
          </div>

          <!-- Funnel Step 3: Coverage Duration & Dynamic Packages -->
          <div class="quote-builder_section" id="qb-section-duration">
            <div class="quote-builder_section-header">
              <span class="quote-builder_step-number">03</span>
              <div>
                <h2 class="quote-builder_step-title text-style-h4">Hours &amp; Packages</h2>
                <p class="quote-builder_step-desc text-style-small">
                  Choose a package or use the slider for custom hours.
                </p>
              </div>
            </div>

            <!-- Headshot options (shown when Workplace Portraits selected) -->
            <div id="qb-headshot-options" hidden>
              <p class="text-style-main">Staff headshots at your workplace. Sessions usually take 1–3 hours, depending on how many people need photos.</p>
              <div class="quote-builder_form-grid">
                <label class="quote-builder_form-field">
                  <span class="quote-builder_form-label">Session length</span>
                  <select id="qb-headshot-hours" class="field-control">
                    <option value="">Not sure yet</option>
                    <option value="1">1 hour</option>
                    <option value="2">2 hours</option>
                    <option value="3">3 hours</option>
                  </select>
                </label>
                <label class="quote-builder_form-field">
                  <span class="quote-builder_form-label">How many people? (optional)</span>
                  <input id="qb-headshot-people" type="number" min="1" step="1" class="field-control" placeholder="Approximate team size" />
                </label>
              </div>
              <p class="text-style-small">Leave anything undecided blank. We'll confirm the time, price and photos included before booking.</p>
            </div>

            <!-- Dynamic Positioning Banner -->
            <div class="quote-builder_value-banner" data-event-only>
              <span class="quote-builder_value-icon">💡</span>
              <div class="quote-builder_value-text text-style-small" id="qb-value-banner-text">
                <strong>Direct booking with Nikolas Gannon.</strong> High-res print and web files, online gallery, full licence, and $10M public liability insurance included.
              </div>
            </div>

            <!-- Dynamic Package Cards Container (Populated by JS for Category) -->
            <div class="quote-builder_grid quote-builder_duration-grid" id="qb-duration-cards-container">
              <!-- Dynamically rendered via JS -->
            </div>

            <!-- Custom Hours Fine-Tuning Block -->
            <div class="quote-builder_custom-hours-block" data-event-only>
              <div class="quote-builder_custom-hours-header">
                <span class="text-style-main"><strong>Need custom hours?</strong></span>
                <span class="text-style-small text-muted">Select exact duration or drag the slider:</span>
              </div>

              <!-- Quick Hours Pills -->
              <div class="quote-builder_pills" id="qb-pills-container" role="group" aria-label="Coverage duration quick selections">
                <!-- Dynamically rendered via JS -->
              </div>

              <!-- Interactive Range Slider -->
              <div class="quote-builder_slider-block">
                <div class="quote-builder_slider-top">
                  <span class="text-style-main">Coverage slider:</span>
                  <span class="quote-builder_slider-val"><strong id="qb-hours-display">8</strong> Hours Coverage</span>
                </div>
                <div class="quote-builder_range-wrapper">
                  <input
                    type="range"
                    id="qb-range-input"
                    min="2"
                    max="12"
                    step="1"
                    value="8"
                    aria-label="Coverage hours range selector"
                    class="quote-builder_range"
                  />
                  <div class="quote-builder_ticks">
                    <span>2h</span>
                    <span>4h (Half)</span>
                    <span>6h</span>
                    <span>8h (Full)</span>
                    <span>10h</span>
                    <span>12h</span>
                  </div>
                </div>
                <div class="quote-builder_deliverables-hint text-style-small">
                  <span>Deliverables:</span> <strong id="qb-photos-estimate">~500–650 edited photos</strong> &bull; <span id="qb-scope-suggestion">Full-day conference coverage</span>
                </div>
              </div>

              <p class="quote-builder_multiday-hint text-style-small text-muted">
                📅 <strong>Planning multiple dates or a custom schedule?</strong> Pick your main duration above and mention your dates in the notes below.
              </p>
            </div>

          </div>

          <!-- Funnel Step 4: Crew, Turnaround & Production Extras -->
          <div class="quote-builder_section" data-event-only>
            <div class="quote-builder_section-header">
              <span class="quote-builder_step-number">04</span>
              <div>
                <h2 class="quote-builder_step-title text-style-h4">Options &amp; Extras</h2>
                <p class="quote-builder_step-desc text-style-small">Add a second photographer or faster turnaround if needed.</p>
              </div>
            </div>

            <div class="quote-builder_options-subgroup">
              <h3 class="quote-builder_subgroup-title text-style-h6">Photographers</h3>
              <div class="quote-builder_grid quote-builder_grid-2">
                <label class="quote-builder_option is-selected">
                  <input type="radio" name="qb_crew" value="single" checked class="quote-builder_sr-only" />
                  <span class="quote-builder_option-mark"><Icon src={checkIcon} variant="small" /></span>
                  <span class="quote-builder_option-content">
                    <strong class="quote-builder_option-title">1 Photographer</strong>
                    <span class="quote-builder_option-desc">For up to 150 guests or single-room schedules.</span>
                    <span class="quote-builder_option-cost">Included</span>
                  </span>
                </label>

                <label class="quote-builder_option" id="qb-second-shooter-card">
                  <input type="radio" name="qb_crew" value="double" class="quote-builder_sr-only" />
                  <span class="quote-builder_option-mark"><Icon src={checkIcon} variant="small" /></span>
                  <span class="quote-builder_option-content">
                    <strong class="quote-builder_option-title">2 Photographers</strong>
                    <span class="quote-builder_option-desc">For concurrent rooms, separate prep locations, or large crowds.</span>
                    <span class="quote-builder_option-cost" id="qb-second-cost">+ $600</span>
                  </span>
                </label>
              </div>
            </div>

            <div class="quote-builder_options-subgroup">
              <h3 class="quote-builder_subgroup-title text-style-h6">Delivery Time</h3>
              <div class="quote-builder_grid quote-builder_grid-turnaround">
                <label class="quote-builder_option is-selected" data-turnaround-cost="0">
                  <input type="radio" name="qb_turnaround" value="standard" checked class="quote-builder_sr-only" />
                  <span class="quote-builder_option-mark"><Icon src={checkIcon} variant="small" /></span>
                  <span class="quote-builder_option-content">
                    <strong class="quote-builder_option-title">Standard Delivery</strong>
                    <span class="quote-builder_option-desc">Full edited gallery in 3–5 business days (2–3 weeks for weddings).</span>
                    <span class="quote-builder_option-cost">Included ($0)</span>
                  </span>
                </label>

                <label class="quote-builder_option" data-turnaround-cost="150">
                  <input type="radio" name="qb_turnaround" value="nextday" class="quote-builder_sr-only" />
                  <span class="quote-builder_option-mark"><Icon src={checkIcon} variant="small" /></span>
                  <span class="quote-builder_option-content">
                    <strong class="quote-builder_option-title">Next-Day Highlights (24h)</strong>
                    <span class="quote-builder_option-desc">15–25 highlight photos within 24 hours for press or social media.</span>
                    <span class="quote-builder_option-cost">+ $150</span>
                  </span>
                </label>

                <label class="quote-builder_option" data-turnaround-cost="300">
                  <input type="radio" name="qb_turnaround" value="sameday" class="quote-builder_sr-only" />
                  <span class="quote-builder_option-mark"><Icon src={checkIcon} variant="small" /></span>
                  <span class="quote-builder_option-content">
                    <strong class="quote-builder_option-title">Same-Day Live Delivery</strong>
                    <span class="quote-builder_option-desc">Photos delivered during the event for immediate PR or social posts.</span>
                    <span class="quote-builder_option-cost">+ $300</span>
                  </span>
                </label>
              </div>
            </div>

            <div class="quote-builder_options-subgroup">
              <h3 class="quote-builder_subgroup-title text-style-h6">Optional Add-ons</h3>
              <div class="quote-builder_grid quote-builder_grid-2">
                <label class="quote-builder_check-option">
                  <input type="checkbox" name="qb_addon_studio" id="qb-addon-studio" value="250" class="quote-builder_sr-only" />
                  <span class="quote-builder_option-mark"><Icon src={checkIcon} variant="small" /></span>
                  <span class="quote-builder_option-content">
                    <strong class="quote-builder_option-title">Mobile Studio &amp; Backdrop</strong>
                    <span class="quote-builder_option-desc">On-site backdrop and studio flash for portraits.</span>
                    <span class="quote-builder_option-cost">+ $250</span>
                  </span>
                </label>

                <label class="quote-builder_check-option">
                  <input type="checkbox" name="qb_addon_sponsor" id="qb-addon-sponsor" value="200" class="quote-builder_sr-only" />
                  <span class="quote-builder_option-mark"><Icon src={checkIcon} variant="small" /></span>
                  <span class="quote-builder_option-content">
                    <strong class="quote-builder_option-title">Commercial Sponsor Licence</strong>
                    <span class="quote-builder_option-desc">Permits event sponsors to use photos in their own marketing.</span>
                    <span class="quote-builder_option-cost">+ $200</span>
                  </span>
                </label>
              </div>
            </div>

          </div>

        </div>

        <!-- Live Estimate Summary Column (Sticky) -->
        <aside class="quote-builder_sidebar">
          <div class="quote-builder_summary-card" id="qb-summary-card">
            
            <div class="quote-builder_summary-top">
              <span class="quote-builder_summary-eyebrow text-style-tag">Estimated Total</span>
              <div class="quote-builder_price-box">
                <span class="quote-builder_price-currency">$</span>
                <span class="quote-builder_price-amount" id="qb-total-price">1,300</span>
                <span class="quote-builder_price-tax">AUD</span>
              </div>
              <p class="quote-builder_price-note text-style-small">No hidden weekend or travel fees across Sydney</p>
            </div>

            <hr class="quote-builder_divider" />

            <!-- Itemized Line Items -->
            <div class="quote-builder_breakdown">
              <h3 class="quote-builder_breakdown-title text-style-h6">Quote Summary</h3>
              <ul class="quote-builder_line-items" id="qb-breakdown-list">
                <li class="quote-builder_line-item">
                  <span class="quote-builder_line-name">8 Hours Coverage (Corporate Conferences &amp; Events)</span>
                  <span class="quote-builder_line-val">$1,300</span>
                </li>
                <li class="quote-builder_line-item">
                  <span class="quote-builder_line-name">1 Photographer</span>
                  <span class="quote-builder_line-val">Included</span>
                </li>
                <li class="quote-builder_line-item">
                  <span class="quote-builder_line-name">Standard Delivery</span>
                  <span class="quote-builder_line-val">$0</span>
                </li>
              </ul>
            </div>

            <hr class="quote-builder_divider" />

            <!-- Inclusions Checklist -->
            <div class="quote-builder_inclusions">
              <h3 class="quote-builder_inclusions-title text-style-h6">What's Included</h3>
              <ul class="quote-builder_inclusions-list" id="qb-inclusions-list">
                <li><Icon src={checkIcon} variant="small" class="quote-builder_tick" /> High-resolution print &amp; web JPEG files</li>
                <li><Icon src={checkIcon} variant="small" class="quote-builder_tick" /> Private online gallery with free downloads</li>
                <li><Icon src={checkIcon} variant="small" class="quote-builder_tick" /> Full photo licence (commercial or personal)</li>
                <li><Icon src={checkIcon} variant="small" class="quote-builder_tick" /> $10M Public Liability Insurance</li>
                <li><Icon src={checkIcon} variant="small" class="quote-builder_tick" /> Dual memory card backup on shoot</li>
              </ul>
            </div>

            <!-- Action Buttons -->
            <div class="quote-builder_actions">
              <a href="#qb-enquiry" class="quote-builder_btn-primary" id="qb-btn-enquire">
                <span>Check Date Availability &rarr;</span>
              </a>
              
              <button type="button" class="quote-builder_btn-secondary" id="qb-btn-copy">
                <span id="qb-copy-text">Copy Summary</span>
              </button>
            </div>

          </div>
        </aside>
      </div>

      <!-- Integrated Fast Inquiry Form -->
      <section id="qb-enquiry" class="quote-builder_form-section">
        <div class="quote-builder_form-container">
          <div class="quote-builder_form-header">
            <span class="text-style-tag">NEXT STEP</span>
            <h2 class="text-style-h2">Check Date Availability</h2>
            <p class="text-style-main">Send your quote details to check availability. We'll reply within 24 hours to confirm.</p>
          </div>

          <form
            id="qb-inquiry-form"
            class="quote-builder_form"
            action={STUDIO_CONTACT.formEndpoint}
            method="post"
            data-hubspot-portal={HUBSPOT_CONFIG.portalId}
            data-hubspot-form={HUBSPOT_CONFIG.formId}
            data-hubspot-region={HUBSPOT_CONFIG.region}
          >
            <!-- Hidden payload containing quote builder summary -->
            <input type="hidden" name="calculatedQuoteSummary" id="qb-hidden-summary" value="" />
            <input type="hidden" name="estimatedTotal" id="qb-hidden-total" value="$1,300" />
            <input type="hidden" name="coverageHours" id="qb-hidden-hours" value="8 Hours" />
            <input type="hidden" name="eventType" id="qb-hidden-type" value="Corporate Conferences & Events" />

            <div class="quote-builder_form-grid">
              <div class="quote-builder_form-field">
                <label for="qb-name" class="quote-builder_form-label text-style-main">Full Name <span class="quote-builder_star">*</span></label>
                <input type="text" id="qb-name" name="fullName" class="field-control" placeholder="e.g. Sarah Jenkins" required />
              </div>

              <div class="quote-builder_form-field">
                <label for="qb-email" class="quote-builder_form-label text-style-main">Email Address <span class="quote-builder_star">*</span></label>
                <input type="email" id="qb-email" name="email" class="field-control" placeholder="sarah@company.com" required />
              </div>

              <div class="quote-builder_form-field">
                <label for="qb-phone" class="quote-builder_form-label text-style-main">Phone <span class="quote-builder_star">*</span></label>
                <input type="tel" id="qb-phone" name="phone" class="field-control" placeholder="+61 400 000 000" required />
              </div>

              <div class="quote-builder_form-field">
                <label for="qb-org" class="quote-builder_form-label text-style-main">Company / Organisation</label>
                <input type="text" id="qb-org" name="organisation" class="field-control" placeholder="Leave blank for personal events" />
              </div>

              <div class="quote-builder_form-field">
                <label for="qb-date" class="quote-builder_form-label text-style-main">Event Date <span class="quote-builder_star">*</span></label>
                <input type="text" id="qb-date" name="eventDate" class="field-control" placeholder="e.g. 18 November 2026 (or TBC)" required />
              </div>

              <div class="quote-builder_form-field">
                <label for="qb-venue" class="quote-builder_form-label text-style-main">Venue / Location <span class="quote-builder_star">*</span></label>
                <input type="text" id="qb-venue" name="venue" class="field-control" placeholder="e.g. ICC Sydney, The Grounds, Private Residence" required />
              </div>

              <div class="quote-builder_form-field quote-builder_form-field-full">
                <label for="qb-notes" class="quote-builder_form-label text-style-main">Event Notes or Questions</label>
                <textarea id="qb-notes" name="message" class="field-control" rows="4" placeholder="Tell us about your event schedule, key moments, or any questions..."></textarea>
              </div>
            </div>

            <div class="quote-builder_form-footer">
              <button type="submit" class="quote-builder_btn-primary quote-builder_btn-large" id="qb-submit-btn">
                <span>Send Enquiry &rarr;</span>
              </button>
              <p class="quote-builder_form-reassurance text-style-small">
                No payment required now. We will check our availability and confirm your details.
              </p>
            </div>

            <div class="quote-builder_status-msg quote-builder_status-success" id="qb-form-success" role="status" style="display: none;">
              <strong>Thank you for your enquiry!</strong> Your quote estimate and event details have been received. We will be in touch shortly to confirm availability.
            </div>
            <div class="quote-builder_status-msg quote-builder_status-error" id="qb-form-error" role="alert" style="display: none;">
              There was an issue sending your enquiry. Please email us directly at <a href={`mailto:${STUDIO_CONTACT.email}`}>{STUDIO_CONTACT.email}</a> or call <a href={`tel:${STUDIO_CONTACT.phoneRaw}`}>{STUDIO_CONTACT.phone}</a>.
            </div>
          </form>
        </div>
      </section>

    </div>
  )
}

<script>
  interface DurationPackage {
    hours: number;
    badge?: string;
    badgeAccent?: boolean;
    name: string;
    price: number;
    rateDesc: string;
    desc: string;
    savings?: string;
    isPopular?: boolean;
  }

  interface SectorTypeOption {
    id: string;
    title: string;
    badge?: string;
    badgeAccent?: boolean;
    desc: string;
    label: string;
    baseMult: number;
    discountLabel?: string;
  }

  // Sector categories mapping
  const SECTOR_TYPES: Record<string, SectorTypeOption[]> = {
    business: [
      {
        id: "corporate",
        title: "Conferences, Summits & Galas",
        badge: "Most Popular",
        badgeAccent: true,
        desc: "Keynote stages, breakout sessions, annual dinners, awards ceremonies, and trade expos.",
        label: "Corporate Conferences, Summits & Galas",
        baseMult: 1.0,
      },
      {
        id: "brand",
        title: "Brand & PR Activations",
        desc: "Pop-ups, media calls, product launches, PR campaigns, and sponsor events.",
        label: "Brand Activations & PR Launches",
        baseMult: 1.0,
      },
      {
        id: "portraits",
        title: "Workplace Portraits & Headshots",
        desc: "On-site mobile studio headshots for teams, executive portraits, and team culture.",
        label: "Workplace Portraits & Headshots",
        baseMult: 1.0,
      },
    ],
    nfp: [
      {
        id: "nfp-gala",
        title: "Charity Galas & Fundraisers",
        badge: "10% Courtesy",
        desc: "Fundraising dinners, live auctions, donor awards, and stage presentations.",
        label: "Not-For-Profit Charity Galas & Fundraisers",
        baseMult: 0.9,
        discountLabel: "10% Community Courtesy Benefit",
      },
      {
        id: "nfp-forum",
        title: "Community Forums & Festivals",
        badge: "10% Courtesy",
        desc: "Advocacy symposiums, public assemblies, and community cultural festivals.",
        label: "Community Forums & Cultural Festivals",
        baseMult: 0.9,
        discountLabel: "10% Community Courtesy Benefit",
      },
    ],
    personal: [
      {
        id: "birthdays",
        title: "Birthdays & Private Parties",
        badge: "Parties",
        desc: "Birthdays, engagement drinks, christenings, baby showers, and family gatherings.",
        label: "Birthdays & Private Celebrations",
        baseMult: 1.0,
      },
      {
        id: "weddings",
        title: "Weddings & Elopements",
        badge: "Fine-Art",
        badgeAccent: true,
