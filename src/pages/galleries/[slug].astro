---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import ContentGallery from "@/components/Content/ContentGallery.astro";
import ContentList from "@/components/Content/ContentList.astro";
import GalleryFacts from "@/components/Item/GalleryFacts.astro";
import { GALLERIES, type GalleryProject } from "@/data/galleries.ts";

export function getStaticPaths() {
  return GALLERIES.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: GalleryProject;
}

const { project } = Astro.props;
---

<Layout
  title={`${project.title} | Sydney Event Photography`}
  description={project.summary}
>
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <ButtonWrapper class="margin-bottom-4">
        <Button element="link" href="/galleries" variant="link">
          &larr; Selected work
        </Button>
      </ButtonWrapper>
      <Eyebrow variant="tag">{project.categoryLabel}</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>{project.title}</Heading>
      <Paragraph variant="large" maxWidth={36}>{project.subtitle}</Paragraph>
    </ContentWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="medium">
    <ContentGallery images={project.images} title={project.title} />
  </Section>

  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper variant="columns">
      <div>
        <Heading tag="h2" variant="h3">Overview</Heading>
        <Paragraph>{project.overview}</Paragraph>
      </div>
      <GalleryFacts
        slot="column2"
        coverage={project.clientRole}
        location={project.location}
        year={project.year}
      />
    </ContentWrapper>
  </Section>

  <Section paddingTop="small" paddingBottom="medium">
    <ContentWrapper variant="columns">
      <div>
        <Heading tag="h2" variant="h3">Scope of Coverage</Heading>
        <ContentList items={project.scope} />
      </div>
      <div slot="column2">
        <Heading tag="h2" variant="h3">Deliverables</Heading>
        <ContentList items={project.deliverables} />
      </div>
    </ContentWrapper>
  </Section>

  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper centered={true}>
      <Heading tag="h2" variant="h2" maxWidth={24}>Planning an Event?</Heading>
      <Paragraph maxWidth={36}>
        Send the date, location, and a short brief. We will reply with
        availability and a clear quote.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Send a brief</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
