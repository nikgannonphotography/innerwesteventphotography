---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import GalleryCard from "@/components/Item/GalleryCard.astro";
import {
  getGalleryCover,
  getGalleryCoverPosition,
} from "@/data/gallery-covers";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import {
  GALLERY_CATEGORIES,
  getCategoryBySlug,
  getGalleriesByCategorySlug,
  type GalleryCategoryMeta,
} from "@/data/galleries.ts";
import { SERVICES } from "@/data/services.ts";
import { LOCATIONS } from "@/data/locations.ts";
import { SITE_NAME, SITE_URL } from "@/consts.ts";

export function getStaticPaths() {
  return GALLERY_CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: GalleryCategoryMeta;
}

const { category: categorySlug } = Astro.params;
const category =
  Astro.props.category ??
  (categorySlug ? getCategoryBySlug(categorySlug) : undefined);

if (!category) {
  return Astro.redirect("/404");
}

const projects = getGalleriesByCategorySlug(category.slug);
const matchedService = SERVICES.find(
  (s) => s.slug === category.matchedServiceSlug,
);

// Structured Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Selected Work",
      item: `${SITE_URL}/galleries`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: category.name,
      item: `${SITE_URL}/galleries/category/${category.slug}`,
    },
  ],
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: category.seoTitle,
  description: category.metaDescription,
  url: `${SITE_URL}/galleries/category/${category.slug}`,
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
  },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: projects.map((p, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${SITE_URL}/galleries/${p.slug}`,
      name: p.title,
    })),
  },
};
---

<Layout
  title={`${category.seoTitle} | ${SITE_NAME}`}
  description={category.metaDescription}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(collectionSchema)}
    />
  </Fragment>

  <!-- Category Hero Header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow variant="tag">PORTFOLIO ARCHIVE</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={24}>{category.name}</Heading>
      <Paragraph variant="large" maxWidth={36}>
        {category.tagline}
      </Paragraph>
      <Paragraph maxWidth={36}>
        {category.description}
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Gallery Projects Grid -->
  <Section paddingTop="none" paddingBottom="large">
    <ContentWrapper>
      {
        projects.length === 0 ? (
          <Paragraph>No case studies found in this category.</Paragraph>
        ) : (
          <Grid small={1} large={projects.length > 2 ? 3 : 2}>
            {projects.map((item) => (
              <GalleryCard
                href={`/galleries/${item.slug}`}
                title={item.title}
                meta={[item.categoryLabel, item.location]
                  .filter(Boolean)
                  .join(" · ")}
                image={getGalleryCover(item)}
                imagePosition={getGalleryCoverPosition(item)}
              />
            ))}
          </Grid>
        )
      }
    </ContentWrapper>
  </Section>

  <!-- Matched Service Deep-Dive -->
  {
    matchedService && (
      <Section paddingTop="medium" paddingBottom="medium">
        <ContentWrapper variant="columns">
          <div>
            <Eyebrow variant="tag">
              PRODUCTION SERVICE {matchedService.number}
            </Eyebrow>
            <Heading tag="h2" variant="h2">
              {matchedService.title}
            </Heading>
            <Paragraph variant="large">{matchedService.tagline}</Paragraph>
            <Paragraph>{matchedService.summary}</Paragraph>
            <ButtonWrapper marginTop="4">
              <Button element="link" href={`/services/${matchedService.slug}`}>
                View Full Service Specs &rarr;
              </Button>
              <Button element="link" href="/contact" emphasis="secondary">
                Get a quote
              </Button>
            </ButtonWrapper>
          </div>

          <div slot="column2">
            <Grid small={1}>
              <div class="service_highlight_card">
                <p class="service_highlight_label">STANDARD DELIVERABLES</p>
                <ul class="service_deliverables_list">
                  {matchedService.deliverables.map((d) => (
                    <li>• {d}</li>
                  ))}
                </ul>
              </div>
              <div class="service_highlight_card">
                <p class="service_highlight_label">COMMISSIONED BY</p>
                <ul class="service_deliverables_list">
                  {matchedService.commissioners.map((c) => (
                    <li>• {c}</li>
                  ))}
                </ul>
              </div>
            </Grid>
          </div>
        </ContentWrapper>
      </Section>
    )
  }

  <!-- Sydney Coverage Hubs -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">SYDNEY VENUES & REGIONS</Eyebrow>
        <Heading tag="h2" variant="h3">Sydney Coverage Locations</Heading>
      </div>
      <ButtonWrapper slot="column2">
        <Button element="link" href="/locations" emphasis="secondary">
          All 60+ Suburbs &rarr;
        </Button>
      </ButtonWrapper>
    </ContentWrapper>

    <Grid small={1} medium={4}>
      {
        LOCATIONS.map((loc) => (
          <a href={`/locations/${loc.slug}`} class="location_summary_card">
            <Heading tag="h3" variant="h6">
              {loc.name}
            </Heading>
            <Paragraph variant="small">{loc.tagline}</Paragraph>
          </a>
        ))
      }
    </Grid>
  </Section>

  <!-- CTA -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">DISCUSS A BRIEF</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}
        >Ready to Scope Your Coverage?</Heading
      >
      <Paragraph maxWidth={36}>
        Send your event date, location and what you need photographed for a
        quote.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Get a quote</Button>
        <Button
          element="link"
          href="/docs/pricing-and-rates-guide"
          variant="link"
        >
          Review Rate Structure
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .service_highlight_card {
      padding: var(--space-4);
      background-color: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: var(--radius-medium);
    }
    .service_highlight_label {
      font-size: var(--font-size-extra-small);
      font-weight: 700;
      letter-spacing: 0.05em;
      color: var(--text-subtle);
      margin-bottom: var(--space-2);
    }
    .service_deliverables_list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      font-size: var(--font-size-small);
      color: var(--text);
    }
    .location_summary_card {
      display: block;
      padding: var(--space-4);
      background-color: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: var(--radius-medium);
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s ease;
    }
    .location_summary_card:hover {
      border-color: var(--text);
    }
  }
</style>
