---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import GalleryCard from "@/components/Item/GalleryCard.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { GALLERIES, GALLERY_CATEGORIES } from "@/data/galleries.ts";

const featuredGallery =
  GALLERIES.find((gallery) => gallery.slug === "sony-foundation-wharf4ward") ??
  GALLERIES[0];
const remainingGalleries = GALLERIES.filter(
  (gallery) => gallery.slug !== featuredGallery.slug,
);
---

<Layout
  title="Selected Work & Case Studies | Inner West Event Photography"
  description="Explore event photography across corporate conferences, charity galas, fashion runways, celebrations, concerts, and sports in Sydney."
>
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow variant="tag">PORTFOLIO</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={20}>Selected Work</Heading>
      <Paragraph variant="large" maxWidth={36}>
        Corporate, not-for-profit, fashion, weddings, celebrations, concerts, and sports photography across Sydney.
      </Paragraph>

      <!-- Category Filter Tabs -->
      <div class="category_nav_wrapper margin-top-4">
        <a href="/galleries" class="category_pill is-active">
          All Case Studies
        </a>
        {GALLERY_CATEGORIES.map((cat) => (
          <a
            href={`/galleries/category/${cat.slug}`}
            class="category_pill"
          >
            {cat.shortName}
          </a>
        ))}
      </div>
    </ContentWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="large">
    <ContentWrapper>
      <Grid small={1}>
        <GalleryCard
          href={`/galleries/${featuredGallery.slug}`}
          title={featuredGallery.title}
          meta={`${featuredGallery.categoryLabel} · ${featuredGallery.location}`}
          image={featuredGallery.posterImage}
          featured
        />
        <Grid small={1} large={3}>
          {
            remainingGalleries.map((item) => (
              <GalleryCard
                href={`/galleries/${item.slug}`}
                title={item.title}
                meta={`${item.categoryLabel} · ${item.location}`}
                image={item.posterImage}
              />
            ))
          }
        </Grid>
      </Grid>
    </ContentWrapper>
  </Section>

  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper centered={true}>
      <Heading tag="h2" variant="h2" maxWidth={24}>Planning an Event?</Heading>
      <Paragraph maxWidth={36}>
        Send the date, location, and a short brief. We will reply with
        availability and a clear quote.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Send a brief</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .category_nav_wrapper {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin-bottom: var(--space-4);
    }
    .category_pill {
      display: inline-block;
      padding: var(--space-1) var(--space-3);
      font-size: var(--font-size-small);
      font-weight: 500;
      color: var(--text);
      background-color: var(--surface-1);
      border: 1px solid var(--border);
      border-radius: var(--radius-full, 9999px);
      text-decoration: none;
      transition: all 0.15s ease;
    }
    .category_pill:hover {
      border-color: var(--text);
      background-color: var(--surface-2);
    }
    .category_pill.is-active {
      background-color: var(--text);
      color: var(--background);
      border-color: var(--text);
    }
  }
</style>
