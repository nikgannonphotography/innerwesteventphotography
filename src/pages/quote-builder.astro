---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import QuoteBuilder from "@/components/Interactive/QuoteBuilder.astro";
---

<Layout
  title="Event Photography Pricing Sydney | Inner West Event Photography"
  description="Choose an event photography coverage time, see the estimated fee, and send the details for a confirmed quote. Sydney event photography from $500."
>
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Heading tag="h1" variant="h1" maxWidth={24}
        >Event photography pricing</Heading
      >
      <Paragraph variant="large" maxWidth={38}>
        Choose the type of photography and the time you need. You will see an
        estimate before sending an enquiry. Weddings and larger headshot teams
        are quoted after a short discussion.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="large">
    <ContentWrapper>
      <QuoteBuilder />
    </ContentWrapper>
  </Section>
</Layout>
