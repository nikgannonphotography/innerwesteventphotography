---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { SERVICES } from "@/data/services.ts";
---

<Layout
  title="Commercial & Event Photography Services | Inner West Event Photography"
  description="Photography for corporate, community and private events, brand campaigns and workplace portraits across Sydney."
>
  <!-- Header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>PHOTOGRAPHY SERVICES</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}
        >Event Photography & Portraits</Heading
      >
      <Paragraph variant="large" maxWidth={36}>
        Photography for events, businesses and families across Sydney.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Services -->
  <Section paddingTop="none" paddingBottom="medium">
    <div class="service-list">
      {
        SERVICES.map((s) => (
          <div class="service-block">
            <ContentWrapper variant="columns">
              <Heading tag="h2" variant="h2">
                {s.title}
              </Heading>
              <div slot="column2">
                <Paragraph variant="large">{s.tagline}</Paragraph>
                <ButtonWrapper marginTop="4">
                  <Button element="link" href={`/services/${s.slug}`}>
                    View service details &rarr;
                  </Button>
                </ButtonWrapper>
              </div>
            </ContentWrapper>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- How it works -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="columns">
      <Heading tag="h2" variant="h2">How It Works</Heading>
      <div slot="column2">
        <Paragraph>
          Tell us your date, location and what you need photographed. We'll agree
          on coverage, price and delivery timing before you book.
        </Paragraph>
        <Paragraph>
          After the shoot, you'll receive edited photos in the agreed formats.
        </Paragraph>
        <ButtonWrapper marginTop="4">
          <Button element="link" href="/docs/pricing-and-rates-guide">
            Pricing Guide
          </Button>
          <Button element="link" href="/docs/event-briefing-template" emphasis="secondary">
            Optional Project Brief
          </Button>
        </ButtonWrapper>
      </div>
    </ContentWrapper>
  </Section>

  <!-- CTA -->
  <Section paddingTop="medium" paddingBottom="large">
    <ContentWrapper centered={true}>
      <Heading tag="h2" variant="h2" maxWidth={24}
        >Get a Quote</Heading
      >
      <Paragraph maxWidth={36}>
        Send your event date, location and what you need photographed.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Request a Quote &rarr;</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .service-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .service-block {
      padding-bottom: var(--space-8);
      border-bottom: var(--border-width) solid var(--border);

      &:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
    }

    .service-block .layout.columns {
      align-items: start;
    }

    .service-block .layout.columns > :first-child {
      align-self: start;
    }

  }
</style>
