---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { SERVICES } from "@/data/services.ts";
---

<Layout
  title="Commercial & Event Photography Services | Inner West Event Photography"
  description="Photography for corporate, community and private events, brand campaigns and workplace portraits across Sydney."
>
  <!-- Header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>PHOTOGRAPHY SERVICES</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}
        >Event Photography & Portraits</Heading
      >
      <Paragraph variant="large" maxWidth={36}>
        Photography for events, businesses and families across Sydney.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Service Offerings Deep-Dive -->
  <Section paddingTop="none" paddingBottom="medium">
    <div class="service-list">
      {
        SERVICES.map((s) => (
          <div class="service-block">
            <ContentWrapper variant="columns">
              <div>
                <Eyebrow variant="tag">SERVICE {s.number}</Eyebrow>
                <Heading tag="h2" variant="h2">
                  {s.title}
                </Heading>
                <Paragraph variant="large">{s.tagline}</Paragraph>
                <Paragraph>{s.summary}</Paragraph>
                <ButtonWrapper marginTop="4">
                  <Button element="link" href={`/services/${s.slug}`}>
                    View service details &rarr;
                  </Button>
                </ButtonWrapper>
              </div>

              <div slot="column2">
                <Grid small={1}>
                  <Card
                    heading="Commissioned By"
                    text={s.commissioners
                      .map((c) => `<span class="meta_line">• ${c}</span>`)
                      .join("")}
                  />
                  <Card
                    heading="How You Can Use the Photos"
                    text={s.businessUses
                      .map((b) => `<span class="meta_line">• ${b}</span>`)
                      .join("")}
                  />
                  <Card
                    heading="Your Photos"
                    text={s.deliverables
                      .map((d) => `<span class="meta_line">• ${d}</span>`)
                      .join("")}
                  />
                </Grid>
              </div>
            </ContentWrapper>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Production Model Overview -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">HOW WE WORK</Eyebrow>
        <Heading tag="h2" variant="h2"
          >From Enquiry to Photos</Heading
        >
        <Paragraph>
          Tell us what you need photographed and how you plan to use the photos.
        </Paragraph>
        <Paragraph>
          We agree on the coverage, cost and delivery timing before you book.
        </Paragraph>
        <ButtonWrapper marginTop="4">
          <Button element="link" href="/docs/pricing-and-rates-guide"
            >Read Rate Guide</Button
          >
          <Button
            element="link"
            href="/docs/event-briefing-template"
            emphasis="secondary">View Briefing Guide</Button
          >
        </ButtonWrapper>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="1. Plan the Shoot"
            text="Share your schedule, important people and the photos you need."
            theme="dark"
          />
          <Card
            heading="2. Take the Photos"
            text="Candid photos, key moments and group photos, following your agreed brief."
            theme="dark"
          />
          <Card
            heading="3. Edit and Deliver"
            text="Edited photos delivered in the agreed formats."
            theme="dark"
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- CTA -->
  <Section paddingTop="medium" paddingBottom="large">
    <ContentWrapper centered={true}>
      <Eyebrow>GET A QUOTE</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}
        >Get a Quote</Heading
      >
      <Paragraph maxWidth={36}>
        Send your event date, location and what you need photographed.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Request a Quote &rarr;</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .service-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .service-block {
      padding-bottom: var(--space-8);
      border-bottom: var(--border-width) solid var(--border);

      &:last-child {
        border-bottom: none;
        padding-bottom: 0;
      }
    }

    .service-block .layout.columns {
      align-items: start;
    }

    .service-block .layout.columns > :first-child {
      align-self: start;
    }

    .meta_line {
      display: block;
      margin-bottom: 0.35rem;
      line-height: 1.4;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }
</style>
