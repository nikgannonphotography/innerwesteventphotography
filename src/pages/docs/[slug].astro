---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import ContentArticle from "@/components/Content/ContentArticle.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import BlogPostCard from "@/components/Item/BlogPostCard.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { DOCS, getDocBySlug, type DocGuide } from "@/data/docs.ts";
import { SERVICES } from "@/data/services.ts";
import { BLOG_POSTS } from "@/data/blog.ts";
import { SITE_NAME, SITE_URL, STUDIO_CONTACT } from "@/consts.ts";

export function getStaticPaths() {
  return DOCS.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

interface Props {
  doc: DocGuide;
}

const { slug } = Astro.params;
const doc = Astro.props.doc ?? (slug ? getDocBySlug(slug) : undefined);

if (!doc) {
  return Astro.redirect("/404");
}
const relatedService = SERVICES.find(
  (service) => service.slug === doc.relatedService,
);
const relatedBlogs = BLOG_POSTS.filter((post) =>
  doc.relatedBlogSlugs.includes(post.slug),
);
const docsBySlug = new Map(DOCS.map((item) => [item.slug, item]));
const configuredDocs = doc.relatedGuides
  .map((slug) => docsBySlug.get(slug))
  .filter((item): item is DocGuide => Boolean(item));
const fallbackDocs = DOCS.filter(
  (item) =>
    item.slug !== doc.slug &&
    item.category === doc.category &&
    !configuredDocs.some((configured) => configured.slug === item.slug),
);
const otherDocs = [...configuredDocs, ...fallbackDocs].slice(0, 3);

const articleSchema = {
  "@type": "Article",
  headline: doc.title,
  description: doc.metaDescription,
  datePublished: doc.publishedDate,
  dateModified: doc.publishedDate,
  mainEntityOfPage: `${SITE_URL}/docs/${doc.slug}`,
  author: {
    "@type": "Person",
    name: "Nikolas Gannon",
    url: `${SITE_URL}/about`,
  },
  publisher: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
  },
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Docs and guides",
      item: `${SITE_URL}/docs`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: doc.title,
      item: `${SITE_URL}/docs/${doc.slug}`,
    },
  ],
};

const guideSchema = {
  "@context": "https://schema.org",
  "@graph": [articleSchema, breadcrumbSchema],
};
---

<Layout title={doc.seoTitle} description={doc.metaDescription}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(guideSchema)}
  />

  <!-- Guide header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <ButtonWrapper class="margin-bottom-4">
        <Button element="link" href="/docs" variant="link">
          &larr; Back to docs and guides
        </Button>
      </ButtonWrapper>
      <Eyebrow variant="tag">{doc.categoryLabel}</Eyebrow>
      <Heading tag="h1" variant="h2" maxWidth={26}>{doc.title}</Heading>
      <div class="article-meta-header">
        <span>Updated {doc.lastUpdated}</span>
        <span class="meta-separator">•</span>
        <span>{doc.readTime}</span>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Guide body -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentArticle>
      <div class="article-intro-block">
        <Paragraph variant="large">{doc.subtitle}</Paragraph>
        <Paragraph>{doc.summary}</Paragraph>
      </div>

      {doc.slug === "event-briefing-template" && (
        <div class="template-download-box">
          <Heading tag="h3" variant="h5">Download the Project Brief</Heading>
          <Paragraph variant="small">
            This Word brief is optional and follows the website enquiry form. Add only the extra details you need. You can request a quote without completing it.
          </Paragraph>
          <ButtonWrapper marginTop="3">
            <Button element="link" href="/downloads/IWEP_Event_Photography_Project_Brief.docx" download="IWEP_Event_Photography_Project_Brief.docx">
              Download Brief (Word) &darr;
            </Button>
            <Button element="link" href="/downloads/IWEP_Event_Photography_Briefing_Template.pdf" download="IWEP_Event_Photography_Briefing_Template.pdf" emphasis="secondary">
              Download PDF &darr;
            </Button>
          </ButtonWrapper>
        </div>
      )}

      {
        doc.sections.map((section) => (
          <div class="article-section-block">
            <Heading tag="h2" variant="h2">
              {section.heading}
            </Heading>
            <Paragraph>{section.content}</Paragraph>

            {section.subsections?.map((subsection) => (
              <div>
                <Heading tag="h3" variant="h4">
                  {subsection.title}
                </Heading>
                <Paragraph>{subsection.body}</Paragraph>
              </div>
            ))}
          </div>
        ))
      }

      <div class="article-conclusion-block">
        <Heading tag="h2" variant="h3">Key points</Heading>
        <ul class="article-list">
          {doc.keyTakeaways.map((takeaway) => <li>{takeaway}</li>)}
        </ul>
        {
          relatedService && (
            <ButtonWrapper marginTop="4">
              <Button
                element="link"
                href={`/services/${relatedService.slug}`}
                variant="link"
              >
                View {relatedService.title} &rarr;
              </Button>
            </ButtonWrapper>
          )
        }
      </div>

      <Grid small={1} medium={3}>
        {
          otherDocs.map((otherDoc) => (
            <Card
              heading={otherDoc.title}
              eyebrow={otherDoc.categoryLabel}
              text={otherDoc.subtitle}
              buttonHref={`/docs/${otherDoc.slug}`}
              buttonLabel="Read guide"
            />
          ))
        }
      </Grid>
    </ContentArticle>
  </Section>

  <!-- Related articles -->
  {
    relatedBlogs.length > 0 && (
      <Section paddingTop="medium" paddingBottom="medium" theme="dark">
        <ContentWrapper variant="auto-width">
          <div>
            <Eyebrow variant="tag">RELATED ARTICLES</Eyebrow>
            <Heading tag="h2" variant="h3">
              Continue reading
            </Heading>
          </div>
          <ButtonWrapper slot="column2">
            <Button element="link" href="/blog" variant="link">
              All guides and articles
            </Button>
          </ButtonWrapper>
        </ContentWrapper>

        <Grid small={1} large={2}>
          {relatedBlogs.map((post) => (
            <BlogPostCard post={post} />
          ))}
        </Grid>
      </Section>
    )
  }

  <!-- Contact -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">GET A QUOTE</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}
        >Planning an Event in Sydney?</Heading
      >
      <Paragraph maxWidth={34}>
        Share your event date, location and what you need photographed for a quote. Email <a href={`mailto:${STUDIO_CONTACT.email}`}>{STUDIO_CONTACT.email}</a>.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Request a Quote &rarr;</Button>
        <Button element="link" href="/downloads/IWEP_Event_Photography_Project_Brief.docx" download="IWEP_Event_Photography_Project_Brief.docx" emphasis="secondary">Download Brief (Word)</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .template-download-box {
      background-color: var(--background-2);
      border: 1px solid var(--border);
      border-radius: var(--radius-main);
      padding: var(--space-6);
      margin-block: var(--space-6);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .article-meta-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-top: var(--space-4);
    }

    .meta-separator {
      color: var(--border);
    }

    @media (width < 40rem) {
      .meta-separator {
        display: none;
      }
    }
  }
</style>
