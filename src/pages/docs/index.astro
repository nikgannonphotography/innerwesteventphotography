---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { DOCS } from "@/data/docs.ts";

const categoryOrder = [
  ["briefing", "Briefing and production planning"],
  ["pricing", "Pricing and scoping"],
  ["delivery", "Delivery and workflow"],
  ["licensing", "Licensing and usage"],
  ["venues", "Venue production"],
] as const;
---

<Layout
  title="Event Photography Production Docs & Guides | Inner West Event Photography"
  description="Technical documentation, briefing templates, pricing rate benchmarks, and licensing specifications for Sydney event managers and marketing directors."
>
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow variant="tag">KNOWLEDGE BASE & PRODUCTION DOCS</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}
        >Event Photography Guides & Specifications</Heading
      >
      <Paragraph variant="large" maxWidth={36}>
        Practical guides for event managers, marketing teams and agency
        producers planning photography across Sydney.
      </Paragraph>
    </ContentWrapper>
  </Section>

  {
    categoryOrder.map(([category, label], index) => {
      const guides = DOCS.filter((doc) => doc.category === category);
      if (guides.length === 0) return null;

      return (
        <Section
          paddingTop={index === 0 ? "none" : "small"}
          paddingBottom="small"
        >
          <ContentWrapper>
            <Eyebrow variant="tag">GUIDE TOPIC</Eyebrow>
            <Heading tag="h2" variant="h3">
              {label}
            </Heading>
          </ContentWrapper>
          <Grid small={1} large={3}>
            {guides.map((doc) => (
              <Card
                heading={doc.title}
                eyebrow={`${doc.number} · ${doc.readTime}`}
                text={doc.summary}
                buttonHref={`/docs/${doc.slug}`}
                buttonLabel="Read guide"
              />
            ))}
          </Grid>
        </Section>
      );
    })
  }

  <!-- Highlight Box: Briefing Download -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">PRODUCTION STANDARD</Eyebrow>
        <Heading tag="h2" variant="h2">Building a clear event brief</Heading>
        <Paragraph>
          A structured brief sets priorities, records timing and gives the
          photographer the information needed to cover the event properly.
        </Paragraph>
        <ButtonWrapper marginTop="4">
          <Button element="link" href="/docs/event-briefing-template"
            >Read Briefing Framework</Button
          >
          <Button element="link" href="/contact" emphasis="secondary"
            >Submit a Brief</Button
          >
        </ButtonWrapper>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="Tier 1: Mandatory Keynotes & VIPs"
            text="Keynote entrances, dignitary arrivals, and award presentations."
            theme="dark"
          />
          <Card
            heading="Tier 2: Sponsor & Partner Activations"
            text="Branded expo booths, stage backdrops, and sponsor banner integrations."
            theme="dark"
          />
          <Card
            heading="Tier 3: Delegate Energy & Atmosphere"
            text="Crowd engagement, dynamic reactions, and ambient room details."
            theme="dark"
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- CTA -->
  <Section paddingTop="medium" paddingBottom="large">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">NEED ADVICE?</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}
        >Need Technical Guidance for an Upcoming Event?</Heading
      >
      <Paragraph maxWidth={36}>
        Questions about venue lighting, additional coverage or priority
        delivery? Send the run sheet and event details.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Send a brief</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
