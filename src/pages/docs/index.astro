---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { DOCS } from "@/data/docs.ts";
---

<Layout
  title="Event Photography Production Docs & Guides | Inner West Event Photography"
  description="Technical documentation, briefing templates, pricing rate benchmarks, and licensing specifications for Sydney event managers and marketing directors."
>
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow variant="tag">KNOWLEDGE BASE & PRODUCTION DOCS</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>Event Photography Guides & Specifications</Heading>
      <Paragraph variant="large" maxWidth={36}>
        Authoritative guides and practical production frameworks designed to help corporate event planners, marketing teams, and agency producers plan flawless visual documentation.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="medium">
    <Grid small={1} large={3}>
      {DOCS.map((doc) => (
        <Card
          heading={doc.title}
          eyebrow={doc.number}
          text={`${doc.summary} (${doc.readTime})`}
          buttonHref={`/docs/${doc.slug}`}
          buttonLabel="Read Full Specification &rarr;"
        />
      ))}
    </Grid>
  </Section>

  <!-- Highlight Box: Briefing Download -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">PRODUCTION STANDARD</Eyebrow>
        <Heading tag="h2" variant="h2">Building a Bulletproof Event Brief</Heading>
        <Paragraph>
          A structured brief aligns expectations, sets clear shot hierarchies, and gives your photographer the operational clarity needed to deliver flawless visual assets.
        </Paragraph>
        <ButtonWrapper marginTop="4">
          <Button element="link" href="/docs/event-briefing-template">Read Briefing Framework</Button>
          <Button element="link" href="/contact" emphasis="secondary">Submit a Brief</Button>
        </ButtonWrapper>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="Tier 1: Mandatory Keynotes & VIPs"
            text="Keynote entrances, dignitary arrivals, and award presentations."
            theme="dark"
          />
          <Card
            heading="Tier 2: Sponsor & Partner Activations"
            text="Branded expo booths, stage backdrops, and sponsor banner integrations."
            theme="dark"
          />
          <Card
            heading="Tier 3: Delegate Energy & Atmosphere"
            text="Crowd engagement, dynamic reactions, and ambient room details."
            theme="dark"
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- CTA -->
  <Section paddingTop="medium" paddingBottom="large">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">NEED ADVICE?</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Need Technical Guidance for an Upcoming Event?</Heading>
      <Paragraph maxWidth={36}>
        Have questions about venue lighting, second shooter scoping, or rapid PR delivery? Let's discuss your run-of-show.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Send a brief</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
