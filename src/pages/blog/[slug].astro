---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Accordion from "@/components/Interactive/Accordion.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import RelatedBlogPosts from "@/components/Item/RelatedBlogPosts.astro";
import ContentArticle from "@/components/Content/ContentArticle.astro";
import {
  BLOG_POSTS,
  BLOG_SERVICE_LINKS,
  getBlogPostBySlug,
  type BlogPost,
} from "@/data/blog.ts";
import { SERVICES } from "@/data/services.ts";
import { SITE_NAME, SITE_URL, STUDIO_CONTACT } from "@/consts.ts";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { slug } = Astro.params;
const post = Astro.props.post ?? (slug ? getBlogPostBySlug(slug) : undefined);

if (!post) {
  return Astro.redirect("/404");
}

const relatedService = SERVICES.find(
  (service) => service.slug === BLOG_SERVICE_LINKS[post.slug],
);

type ArticleBodyBlock =
  | { type: "paragraph"; text: string }
  | { type: "ordered" | "unordered"; items: string[] };

function groupArticleBody(lines: string[]): ArticleBodyBlock[] {
  const blocks: ArticleBodyBlock[] = [];

  for (const line of lines) {
    const ordered = line.match(/^\d+\.\s+(.*)$/);
    const unordered = line.match(/^[•-]\s+(.*)$/);
    const type = ordered ? "ordered" : unordered ? "unordered" : null;
    const text = ordered?.[1] ?? unordered?.[1] ?? line;

    if (!type) {
      blocks.push({ type: "paragraph", text });
      continue;
    }

    const previous = blocks.at(-1);
    if (previous?.type === type) {
      previous.items.push(text);
    } else {
      blocks.push({ type, items: [text] });
    }
  }

  return blocks;
}

function formatMarkdownText(raw: string): string {
  let text = raw.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
  text = text.replace(/(?<!\*)\*(?!\*)(.*?)(?<!\*)\*(?!\*)/g, "<em>$1</em>");

  if (!text.includes("<strong>")) {
    const colonMatch = text.match(/^([A-Z0-9][^:]{2,45}):\s+(.*)$/);
    if (colonMatch) {
      text = `<strong>${colonMatch[1]}:</strong> ${colonMatch[2]}`;
    }
  }
  return text;
}

// JSON-LD Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.seoTitle,
  "description": post.metaDescription,
  "image": `${SITE_URL}${post.heroImage}`,
  "datePublished": post.isoDate,
  "dateModified": post.isoDate,
  "author": {
    "@type": "Person",
    "name": post.author,
    "jobTitle": "Photographer & Creative Producer",
    "url": `${SITE_URL}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_NAME,
    "url": SITE_URL
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/${post.slug}`
  }
};
---

<Layout
  title={post.seoTitle}
  description={post.metaDescription}
  type="article"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <!-- Article header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <ButtonWrapper class="margin-bottom-4">
        <Button element="link" href="/blog" variant="link">
          &larr; Back to All Articles
        </Button>
      </ButtonWrapper>
      <Eyebrow variant="tag">{post.categoryLabel}</Eyebrow>
      <Heading tag="h1" variant="h2" maxWidth={26}>{post.title}</Heading>
      <div class="article-meta-header">
        <span>By <strong>{post.author}</strong></span>
        <span class="meta-separator">•</span>
        <span>{post.date}</span>
        <span class="meta-separator">•</span>
        <span>{post.readTime}</span>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Article image -->
  <Section paddingTop="none" paddingBottom="small">
    <div class="article-hero-wrap">
      <img
        src={post.heroImage}
        alt={post.title}
        class="article-hero-img"
        loading="eager"
      />
    </div>
  </Section>

  <!-- Article body -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentArticle>
      <div class="article-intro-block">
        <Paragraph variant="large">{post.content.intro}</Paragraph>
      </div>

      {post.content.sections.map((sec) => (
        <div class="article-section-block">
          <Heading tag="h2" variant="h2">{sec.heading}</Heading>
          {groupArticleBody(sec.body).map((block) => (
            block.type === "paragraph" ? (
              <Paragraph>
                <Fragment set:html={formatMarkdownText(block.text)} />
              </Paragraph>
            ) : block.type === "ordered" ? (
              <ol class="article-list">
                {block.items.map((item) => (
                  <li>
                    <Fragment set:html={formatMarkdownText(item)} />
                  </li>
                ))}
              </ol>
            ) : (
              <ul class="article-list">
                {block.items.map((item) => (
                  <li>
                    <Fragment set:html={formatMarkdownText(item)} />
                  </li>
                ))}
              </ul>
            )
          ))}

          {sec.callout && (
            <div class="article-callout">
              <Paragraph><strong>Note:</strong> {sec.callout}</Paragraph>
            </div>
          )}

          {sec.tableData && (
            <div class="article-table-wrap">
              <table class="article-table">
                <thead>
                  <tr>
                    {sec.tableData.headers.map((h) => (
                      <th>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {sec.tableData.rows.map((row) => (
                    <tr>
                      {row.map((cell, cIdx) => (
                        <td class={cIdx === 0 ? "font-bold" : ""}>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {sec.faqList && (
            <div class="article-faqs-wrap">
              <Accordion openFirst={true}>
                {sec.faqList.map((faq) => (
                  <AccordionItem heading={faq.q}>
                    <Paragraph>{faq.a}</Paragraph>
                  </AccordionItem>
                ))}
              </Accordion>
            </div>
          )}
        </div>
      ))}

      <div class="article-conclusion-block">
        <Paragraph variant="large">{post.content.conclusion}</Paragraph>
        {relatedService && (
          <ButtonWrapper marginTop="4">
            <Button
              element="link"
              href={`/services/${relatedService.slug}`}
              variant="link"
            >
              View {relatedService.title}
            </Button>
          </ButtonWrapper>
        )}
      </div>

      <RelatedBlogPosts currentSlug={post.slug} />
    </ContentArticle>
  </Section>

  <!-- Contact -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">GET A FIXED QUOTE</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Planning an Event in Sydney?</Heading>
      <Paragraph maxWidth={34}>
        Share your event date, venue, and schedule. We review your requirements and reply promptly with a clear, fixed quote. Email <a href={`mailto:${STUDIO_CONTACT.email}`}>{STUDIO_CONTACT.email}</a>.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Request a Quote &rarr;</Button>
        <Button element="link" href="/docs/event-briefing-template" emphasis="secondary">Download Briefing Template</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .article-meta-header {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-top: var(--space-4);
    }

    .meta-separator {
      color: var(--border);
    }

    .article-hero-wrap {
      width: 100%;
      max-width: var(--max-width-main);
      margin-inline: auto;
      border-radius: var(--radius-main);
      overflow: hidden;
      aspect-ratio: 21 / 9;
      background-color: var(--background-2);
    }

    .article-hero-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    @media (width < 40rem) {
      .article-meta-header {
        gap: var(--space-2) var(--space-3);
      }

      .meta-separator {
        display: none;
      }
    }
  }
</style>
