---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Accordion from "@/components/Interactive/Accordion.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import RelatedBlogPosts from "@/components/Item/RelatedBlogPosts.astro";
import ContentArticle from "@/components/Content/ContentArticle.astro";
import ContentArticleHeader from "@/components/Content/ContentArticleHeader.astro";
import {
  BLOG_POSTS,
  BLOG_SERVICE_LINKS,
  getBlogPostBySlug,
  type BlogPost,
} from "@/data/blog.ts";
import { SERVICES } from "@/data/services.ts";
import { SITE_NAME, SITE_URL, STUDIO_CONTACT } from "@/consts.ts";

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { slug } = Astro.params;
const post = Astro.props.post ?? (slug ? getBlogPostBySlug(slug) : undefined);

if (!post) {
  return Astro.redirect("/404");
}

const relatedService = SERVICES.find(
  (service) => service.slug === BLOG_SERVICE_LINKS[post.slug],
);

type ArticleBodyBlock =
  | { type: "paragraph"; text: string }
  | { type: "ordered" | "unordered"; items: string[] };

function groupArticleBody(lines: string[]): ArticleBodyBlock[] {
  const blocks: ArticleBodyBlock[] = [];

  for (const line of lines) {
    const ordered = line.match(/^\d+\.\s+(.*)$/);
    const unordered = line.match(/^[•-]\s+(.*)$/);
    const type = ordered ? "ordered" : unordered ? "unordered" : null;
    const text = ordered?.[1] ?? unordered?.[1] ?? line;

    if (!type) {
      blocks.push({ type: "paragraph", text });
      continue;
    }

    const previous = blocks.at(-1);
    if (previous?.type === type) {
      previous.items.push(text);
    } else {
      blocks.push({ type, items: [text] });
    }
  }

  return blocks;
}

function formatMarkdownText(raw: string): string {
  let text = raw.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
  text = text.replace(/(?<!\*)\*(?!\*)(.*?)(?<!\*)\*(?!\*)/g, "<em>$1</em>");

  return text;
}

// JSON-LD Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.seoTitle,
  "description": post.metaDescription,
  "image": `${SITE_URL}${post.heroImage}`,
  "datePublished": post.isoDate,
  "dateModified": post.isoDate,
  "author": {
    "@type": "Person",
    "name": post.author,
    "jobTitle": "Photographer & Creative Producer",
    "url": `${SITE_URL}/about`
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE_NAME,
    "url": SITE_URL
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${SITE_URL}/blog/${post.slug}`
  }
};
---

<Layout
  title={post.seoTitle}
  description={post.metaDescription}
  type="article"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />

  <Section paddingTop="small" paddingBottom="none">
    <ContentArticleHeader title={post.title} category={post.categoryLabel} backHref="/blog" backLabel="Back to all articles" metadata={[`By ${post.author}`, post.date, post.readTime]} image={post.heroImage} />
  </Section>

  <!-- Article body -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentArticle>
      <div class="article-intro-block">
        <Paragraph variant="large">{post.content.intro}</Paragraph>
      </div>

      {post.content.sections.map((sec) => (
        <div class="article-section-block">
          <Heading tag="h2" variant="h2">{sec.heading}</Heading>
          {groupArticleBody(sec.body).map((block) => (
            block.type === "paragraph" ? (
              <Paragraph>
                <Fragment set:html={formatMarkdownText(block.text)} />
              </Paragraph>
            ) : block.type === "ordered" ? (
              <ol class="article-list">
                {block.items.map((item) => (
                  <li>
                    <Fragment set:html={formatMarkdownText(item)} />
                  </li>
                ))}
              </ol>
            ) : (
              <ul class="article-list">
                {block.items.map((item) => (
                  <li>
                    <Fragment set:html={formatMarkdownText(item)} />
                  </li>
                ))}
              </ul>
            )
          ))}

          {sec.callout && (
            <div class="article-callout">
              <Paragraph>{sec.callout}</Paragraph>
            </div>
          )}

          {sec.tableData && (
            <div class="article-table-wrap" tabindex="0" role="region" aria-label={`${sec.heading} comparison table`}>
              <table class="article-table">
                <thead>
                  <tr>
                    {sec.tableData.headers.map((h) => (
                      <th scope="col">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {sec.tableData.rows.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {sec.faqList && (
            <div class="article-faqs-wrap">
              <Accordion openFirst={true}>
                {sec.faqList.map((faq) => (
                  <AccordionItem heading={faq.q}>
                    <Paragraph>{faq.a}</Paragraph>
                  </AccordionItem>
                ))}
              </Accordion>
            </div>
          )}
        </div>
      ))}

      <div class="article-conclusion-block">
        <Paragraph variant="large">{post.content.conclusion}</Paragraph>
        {relatedService && (
          <ButtonWrapper marginTop="4">
            <Button
              element="link"
              href={`/services/${relatedService.slug}`}
              variant="link"
            >
              View {relatedService.title}
            </Button>
          </ButtonWrapper>
        )}
      </div>
    </ContentArticle>
  </Section>

  <Section paddingTop="small" paddingBottom="medium">
    <RelatedBlogPosts currentSlug={post.slug} />
  </Section>

  <!-- Contact -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">GET A QUOTE</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Planning an Event in Sydney?</Heading>
      <Paragraph maxWidth={34}>
        Share your event date, location and what you need photographed for a quote. Email <a href={`mailto:${STUDIO_CONTACT.email}`}>{STUDIO_CONTACT.email}</a>.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Request a Quote &rarr;</Button>
        <Button element="link" href="/docs/event-briefing-template" emphasis="secondary">View Briefing Guide</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
