---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import {
  LOCATIONS,
  getLocationBySlug,
  type LocationHub,
} from "@/data/locations.ts";
import { GALLERIES } from "@/data/galleries.ts";
import { DOCS, type DocGuide } from "@/data/docs.ts";

export function getStaticPaths() {
  return LOCATIONS.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

interface Props {
  location: LocationHub;
}

const { slug } = Astro.params;
const location =
  Astro.props.location ?? (slug ? getLocationBySlug(slug) : undefined);

if (!location) {
  return Astro.redirect("/404");
}

// Related case studies
const matchedGalleries = GALLERIES.filter((g) =>
  location.relatedGalleries.includes(g.slug),
);
const planningGuides = location.relatedGuideSlugs
  .map((slug) => DOCS.find((guide) => guide.slug === slug))
  .filter((guide): guide is DocGuide => Boolean(guide));
const otherLocations = LOCATIONS.filter((l) => l.slug !== location.slug);

const locationSchema = {
  "@context": "https://schema.org",
  "@type": "Place",
  name: `${location.name} Event Photography Coverage`,
  description: location.description,
  address: {
    "@type": "PostalAddress",
    addressLocality: location.name,
    addressRegion: "NSW",
    addressCountry: "AU",
  },
  containsPlace: location.suburbs.map((suburb) => ({
    "@type": "AdministrativeArea",
    name: suburb,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.innerwesteventphotography.com.au",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Sydney Coverage Hubs",
      item: "https://www.innerwesteventphotography.com.au/locations",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: location.name,
      item: `https://www.innerwesteventphotography.com.au/locations/${location.slug}`,
    },
  ],
};
---

<Layout
  title={`${location.name} Event Photography | Sydney Studio`}
  description={`${location.name} event photography by Nikolas Gannon. ${location.tagline}`}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(locationSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <!-- Hero -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <ButtonWrapper class="margin-bottom-4">
        <Button element="link" href="/locations" variant="link">
          &larr; Back to All Locations
        </Button>
      </ButtonWrapper>
      <Eyebrow variant="tag">SYDNEY COVERAGE</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}
        >{location.name} Event Photography</Heading
      >
      <Paragraph variant="large" maxWidth={38}>{location.tagline}</Paragraph>
      <Paragraph maxWidth={38}>{location.description}</Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Get a quote</Button>
        <Button element="link" href="/services" variant="link">
          View Services
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Key Venues & Suburbs Grid -->
  <Section paddingTop="none" paddingBottom="medium">
    <Grid small={1} medium={3}>
      <Card
        heading={`Suburbs Covered (${location.suburbs.length})`}
        text={location.suburbs
          .map((s) => `<span class="suburb_pill">${s}</span>`)
          .join(" ")}
      />
      <Card
        heading="Prominent Venues"
        text={location.keyVenues
          .map((v) => `<span class="meta_line">• ${v}</span>`)
          .join("")}
      />
      <Card
        heading="Typical Assignments"
        text={location.eventTypes
          .map((e) => `<span class="meta_line">• ${e}</span>`)
          .join("")}
      />
    </Grid>
  </Section>

  <!-- Regional Logistics -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">LOCAL LOGISTICS</Eyebrow>
        <Heading tag="h2" variant="h2">Planning Around Your Venue</Heading>
        <Paragraph>
          Share your venue contact and any access or photography requirements
          before the event.
        </Paragraph>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="Venue Access"
            text="Let us know about access times, parking and any venue induction requirements."
            theme="dark"
          />
          <Card
            heading="Photo Delivery"
            text="Delivery timing and file formats are agreed before booking."
            theme="dark"
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Related Case Studies in this Region -->
  {
    matchedGalleries.length > 0 && (
      <Section paddingTop="medium" paddingBottom="medium">
        <ContentWrapper variant="auto-width">
          <div>
            <Eyebrow variant="tag">PORTFOLIO</Eyebrow>
            <Heading tag="h2" variant="h3">
              Selected Work Shot in {location.name}
            </Heading>
          </div>
          <ButtonWrapper slot="column2">
            <Button element="link" href="/galleries" emphasis="secondary">
              All Assignments &rarr;
            </Button>
          </ButtonWrapper>
        </ContentWrapper>

        <Grid small={1} medium={3}>
          {matchedGalleries.map((item) => (
            <Card
              heading={item.title}
              text={`${item.subtitle} (${item.year})`}
              buttonHref={`/galleries/${item.slug}`}
              buttonLabel="View Case Study"
              image={item.posterImage}
              variant="stacked"
            />
          ))}
        </Grid>
      </Section>
    )
  }

  <!-- Planning Guides -->
  {
    planningGuides.length > 0 && (
      <Section paddingTop="medium" paddingBottom="medium">
        <ContentWrapper variant="auto-width">
          <div>
            <Eyebrow variant="tag">PLANNING GUIDES</Eyebrow>
            <Heading tag="h2" variant="h3">
              Planning for {location.name}
            </Heading>
          </div>
          <ButtonWrapper slot="column2">
            <Button element="link" href="/docs" emphasis="secondary">
              All Docs and Guides &rarr;
            </Button>
          </ButtonWrapper>
        </ContentWrapper>

        <Grid small={1} medium={3}>
          {planningGuides.map((guide) => (
            <Card
              heading={guide.title}
              text={guide.summary}
              buttonHref={`/docs/${guide.slug}`}
              buttonLabel="Read Guide"
            />
          ))}
        </Grid>
      </Section>
    )
  }

  <!-- Cross-Region Navigator -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">ALL SYDNEY HUBS</Eyebrow>
        <Heading tag="h2" variant="h3"
          >Explore Other Sydney Coverage Regions</Heading
        >
      </div>
    </ContentWrapper>

    <Grid small={1} medium={3}>
      {
        otherLocations.map((loc) => (
          <Card
            heading={loc.name}
            text={loc.tagline}
            buttonHref={`/locations/${loc.slug}`}
            buttonLabel={`Explore ${loc.name}`}
          />
        ))
      }
    </Grid>
  </Section>

  <!-- CTA -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">DISCUSS A BRIEF</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}
        >Planning an Event in {location.name}?</Heading
      >
      <Paragraph maxWidth={36}>
        Reach out with your date, venue location, and expected run-of-show for a
        prompt, transparent quote.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Get a quote</Button>
        <Button
          element="link"
          href="/docs/event-briefing-template"
          variant="link"
        >
          View Briefing Guide
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .meta_line {
      display: block;
      margin-bottom: 0.35rem;
      line-height: 1.4;

      &:last-child {
        margin-bottom: 0;
      }
    }

    .suburb_pill {
      display: inline-block;
      margin: 0.15rem 0.2rem;
      padding: 0.2rem 0.55rem;
      background: var(--background);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--text);
      line-height: 1.3;
    }
  }
</style>
