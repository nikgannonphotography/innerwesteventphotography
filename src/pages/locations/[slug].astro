---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { LOCATIONS, type LocationHub } from "@/data/locations.ts";
import { GALLERIES } from "@/data/galleries.ts";

export function getStaticPaths() {
  return LOCATIONS.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

interface Props {
  location: LocationHub;
}

const { location } = Astro.props;

// Related case studies
const matchedGalleries = GALLERIES.filter((g) =>
  location.relatedGalleries.includes(g.slug)
);
---

<Layout
  title={`${location.name} Event Photography | Inner West Event Photography`}
  description={location.description}
>
  <!-- Hero -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <ButtonWrapper class="margin-bottom-4">
        <Button element="link" href="/locations" variant="link">
          &larr; Back to All Coverage Hubs
        </Button>
      </ButtonWrapper>
      <Eyebrow variant="tag">REGIONAL COVERAGE HUB</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>{location.name} Event Photography</Heading>
      <Paragraph variant="large" maxWidth={38}>{location.tagline}</Paragraph>
      <Paragraph maxWidth={38}>{location.description}</Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Send a brief</Button>
        <Button element="link" href="/services" variant="link">
          View Services & Deliverables
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Key Venues & Suburbs -->
  <Section paddingTop="none" paddingBottom="medium">
    <Grid small={1} medium={3}>
      <Card
        heading="Key Suburbs"
        text={location.suburbs.map((s) => `<span class="meta_line">• ${s}</span>`).join("")}
      />
      <Card
        heading="Prominent Venues"
        text={location.keyVenues.map((v) => `<span class="meta_line">• ${v}</span>`).join("")}
      />
      <Card
        heading="Typical Assignments"
        text={location.eventTypes.map((e) => `<span class="meta_line">• ${e}</span>`).join("")}
      />
    </Grid>
  </Section>

  <!-- Regional Logistics -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">LOCAL LOGISTICS</Eyebrow>
        <Heading tag="h2" variant="h2">On-Site Execution & Venue Standards</Heading>
        <Paragraph>
          Every venue has unique loading dock, induction, and stage lighting requirements. We handle all pre-event logistics to ensure seamless execution on the day.
        </Paragraph>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="Venue Induction & Loading"
            text="Completed contractor safety inductions and coordinated loading dock access for smooth gear bump-in."
            theme="dark"
          />
          <Card
            heading="Public Liability Insurance"
            text="Comprehensive Public Liability Insurance meeting the mandatory compliance standards of all major Sydney venues."
            theme="dark"
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Related Case Studies in this Region -->
  {matchedGalleries.length > 0 && (
    <Section paddingTop="medium" paddingBottom="medium">
      <ContentWrapper variant="auto-width">
        <div>
          <Eyebrow variant="tag">PORTFOLIO</Eyebrow>
          <Heading tag="h2" variant="h3">Selected Work Shot in {location.name}</Heading>
        </div>
        <ButtonWrapper slot="column2">
          <Button element="link" href="/galleries" emphasis="secondary">
            All Assignments &rarr;
          </Button>
        </ButtonWrapper>
      </ContentWrapper>

      <Grid small={1} medium={3}>
        {matchedGalleries.map((item) => (
          <Card
            heading={item.title}
            text={`${item.subtitle} (${item.year})`}
            buttonHref={`/galleries/${item.slug}`}
            buttonLabel="View Case Study"
            image={item.posterImage}
            variant="stacked"
          />
        ))}
      </Grid>
    </Section>
  )}

  <!-- CTA -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">DISCUSS A BRIEF</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Planning an Event in {location.name}?</Heading>
      <Paragraph maxWidth={36}>
        Reach out with your date, venue location, and expected run-of-show for a prompt, transparent quote.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Send a brief</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .meta_line {
      display: block;
      margin-bottom: 0.35rem;
      line-height: 1.4;

      &:last-child {
        margin-bottom: 0;
      }
    }
  }
</style>
