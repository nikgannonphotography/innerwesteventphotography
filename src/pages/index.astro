---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import BlogPostCard from "@/components/Item/BlogPostCard.astro";
import LogoBar from "@/components/Item/LogoBar.astro";
import Accordion from "@/components/Interactive/Accordion.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";
import Img from "@/components/Media/Img.astro";
import { STUDIO_CONTACT } from "@/consts.ts";
import { getFeaturedGalleries } from "@/data/galleries.ts";
import { SERVICES } from "@/data/services.ts";
import { BLOG_POSTS } from "@/data/blog.ts";
import { LOCATIONS } from "@/data/locations.ts";

const selectedWork = getFeaturedGalleries().slice(0, 4);
const featuredArticles = BLOG_POSTS.slice(0, 3);
---

<Layout
  title="Sydney Event Photography | Corporate Conferences, Summits & Galas"
  description="Inner West Event Photography is a Sydney photography studio led by Nikolas Gannon. Quiet, dependable documentary coverage for corporate conferences, charity galas, brand activations, and workplace teams across Sydney."
>
  <!-- Hero -->
  <Section
    id="hero"
    class="home-hero"
    containerClass="home-hero_content"
    paddingTop="even"
    paddingBottom="even"
    theme="dark"
    fullHeight={true}
  >
    <Img
      slot="background"
      src={selectedWork[0]?.posterImage}
      alt="Sydney corporate and event photography coverage"
      loading="eager"
      fetchPriority="high"
      class="home-hero_media object-fit-cover"
    />
    <div slot="background" class="home-hero_scrim"></div>
    <ContentWrapper class="home-hero_copy">
      <Eyebrow variant="tag">Inner West Event Photography</Eyebrow>
      <Heading variant="h1" maxWidth={22} tag="h1">Sydney Event Photography Built Around Your Brief</Heading>
      <Paragraph variant="large" maxWidth={36}>
        Documentary event, conference, gala, and workplace photography across Sydney.
      </Paragraph>
      <ButtonWrapper marginTop="5">
        <Button element="link" href="/contact">Send a brief</Button>
        <Button element="link" href="#work" variant="link">View selected work</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Selected work -->
  <Section id="work" paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">SELECTED WORK</Eyebrow>
        <Heading tag="h2" variant="h2">Galleries</Heading>
      </div>
      <ButtonWrapper slot="column2">
        <Button element="link" href="/galleries" variant="link">Explore all galleries</Button>
      </ButtonWrapper>
    </ContentWrapper>

    <Grid small={1} medium={2} large={4}>
      {
        selectedWork.map((item) => (
          <Card heading={item.title} eyebrow={item.categoryLabel} text={item.location} buttonHref={`/galleries/${item.slug}`} buttonLabel="View assignment" image={item.posterImage} imageAlt={item.title} variant="stacked" />
        ))
      }
    </Grid>
  </Section>

  <!-- Proof and delivery -->
  <Section id="proof" paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">PRODUCTION STANDARD</Eyebrow>
        <Heading tag="h2" variant="h2">Our Approach</Heading>
      </div>
    </ContentWrapper>

    <Grid small={1} medium={2} large={4}>
      <div>
        <Heading tag="h3" variant="h5">Clear delivery</Heading>
        <Paragraph>Delivery timing and priority selects are scoped against your event schedule and communications deadlines.</Paragraph>
      </div>
      <div>
        <Heading tag="h3" variant="h5">Commercial usage</Heading>
        <Paragraph>Usage rights are included upfront in your quote, covering internal, media, sponsor, and social distribution.</Paragraph>
      </div>
      <div>
        <Heading tag="h3" variant="h5">Scalable coverage</Heading>
        <Paragraph>Additional photographers or video specialists are scoped when concurrent rooms or larger programs require them.</Paragraph>
      </div>
      <div>
        <Heading tag="h3" variant="h5">Venue-ready</Heading>
        <Paragraph>A current Certificate of Currency can be provided when your venue or production team requires it.</Paragraph>
      </div>
    </Grid>

    <LogoBar theme="dark" label="Work trusted by" />
  </Section>

  <!-- Services -->
  <Section id="services" paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">SERVICES</Eyebrow>
        <Heading tag="h2" variant="h2">Photography Services</Heading>
      </div>
      <ButtonWrapper slot="column2">
        <Button element="link" href="/services" variant="link">Explore all services</Button>
      </ButtonWrapper>
    </ContentWrapper>

    <Grid small={1} medium={2} large={3}>
      {SERVICES.map((service) => (
        <div class="flex-vertical-nowrap">
          <Heading tag="h3" variant="h5">{service.title}</Heading>
          <Paragraph>{service.tagline}</Paragraph>
          <ButtonWrapper class="margin-top-auto">
            <Button element="link" href={`/services/${service.slug}`} variant="link">
              View {service.title}
            </Button>
          </ButtonWrapper>
        </div>
      ))}
    </Grid>
  </Section>

  <!-- Sydney coverage -->
  <Section id="coverage" paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">SYDNEY COVERAGE</Eyebrow>
        <Heading tag="h2" variant="h2">Available across Greater Sydney</Heading>
      </div>
    </ContentWrapper>

    <Grid small={1} medium={2} large={4}>
      {LOCATIONS.map((location) => (
        <div class="flex-vertical-nowrap">
          <Heading tag="h3" variant="h5">{location.name}</Heading>
          <Paragraph>{location.tagline}</Paragraph>
          <ButtonWrapper class="margin-top-auto">
            <Button element="link" href={`/locations/${location.slug}`} variant="link">View {location.name} coverage</Button>
          </ButtonWrapper>
        </div>
      ))}
    </Grid>
  </Section>

  <!-- Articles -->
  <Section id="articles" paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">LATEST ARTICLES</Eyebrow>
        <Heading tag="h2" variant="h2">Guides &amp; Articles</Heading>
      </div>
      <ButtonWrapper slot="column2">
        <Button element="link" href="/blog" variant="link">All guides &amp; articles</Button>
      </ButtonWrapper>
    </ContentWrapper>

    <Grid small={1} large={3}>
      {featuredArticles.map((post) => <BlogPostCard post={post} />)}
    </Grid>
  </Section>

  <!-- FAQ -->
  <Section id="faq" paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="sticky-content">
      <div>
        <Eyebrow variant="tag">BOOKING QUESTIONS</Eyebrow>
        <Heading tag="h2" variant="h2">The practical details</Heading>
        <Paragraph maxWidth={30}>
          Four common questions before a corporate event photography brief is approved.
        </Paragraph>
      </div>

      <Accordion slot="column2" openFirst={true}>
        <AccordionItem heading="How quickly can priority images be delivered?">
          <Paragraph>
            Priority selects can be scoped around media, stakeholder and social deadlines. Full-gallery timing is confirmed in your upfront quote.
          </Paragraph>
        </AccordionItem>
        <AccordionItem heading="What usage rights are included?">
          <Paragraph>
            Usage is agreed against the ways your organisation, media partners and sponsors need to use the images.
          </Paragraph>
        </AccordionItem>
        <AccordionItem heading="Can you cover concurrent rooms or large programs?">
          <Paragraph>
            Yes. Additional photographers and specialists are scoped when the run sheet requires simultaneous coverage.
          </Paragraph>
        </AccordionItem>
        <AccordionItem heading="Can you provide proof of insurance?">
          <Paragraph>
            Yes. A current Certificate of Currency can be supplied for venue and production approvals.
          </Paragraph>
        </AccordionItem>
      </Accordion>
    </ContentWrapper>
  </Section>

  <!-- Contact -->
  <Section id="contact" paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">GET A FIXED QUOTE</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Tell Us About Your Upcoming Event</Heading>
      <Paragraph maxWidth={36}>
        Share your event date, venue, and schedule. We review your details and send through a clear, fixed quote within 24 hours. Email <a href={`mailto:${STUDIO_CONTACT.email}`}>{STUDIO_CONTACT.email}</a> or call <a href={`tel:${STUDIO_CONTACT.phoneRaw}`}>{STUDIO_CONTACT.phone}</a>.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Request a Quote &rarr;</Button>
        <Button element="link" href="/docs/event-briefing-template" emphasis="secondary">Download Briefing Template</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .home-hero {
      isolation: isolate;
      justify-content: flex-end;
      overflow: clip;
    }

    .home-hero_media {
      z-index: -2;
      object-position: center 42%;
    }

    .home-hero_scrim {
      z-index: -1;
      background-color: rgb(31 29 30 / 58%);
    }

    .home-hero_content {
      justify-content: flex-end;
    }

    .home-hero_copy {
      max-width: 48rem;
    }

    @media (width < 48rem) {
      .home-hero_media {
        object-position: 58% center;
      }
    }
  }
</style>
