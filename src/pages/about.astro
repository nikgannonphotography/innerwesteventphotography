---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import LogoBar from "@/components/Item/LogoBar.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { STUDIO_CONTACT } from "@/consts.ts";
---

<Layout
  title="About Nikolas Gannon & The Studio | Sydney Event Photography"
  description="Meet Nikolas Gannon, the photographer behind Inner West Event Photography. Event, community and commercial photography across Sydney."
>
  <!-- Hero -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>ABOUT THE STUDIO</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>About Inner West Event Photography</Heading>
      <Paragraph variant="large" maxWidth={38}>
        Inner West Event Photography is run by <strong>Nikolas Gannon</strong>, based in Sydney's Inner West. We photograph corporate events, charity galas, community gatherings and private celebrations across Sydney.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Founder Background & Operating Model -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">FOUNDER & LEAD</Eyebrow>
        <Heading tag="h2" variant="h2">Nikolas Gannon</Heading>
        <Paragraph variant="large">
          Photographer & Creative Producer
        </Paragraph>
        <Paragraph>
          Nik's background spans documentary photography, events and creative production. As Client Engagement Director at <em>We Are World Change</em>, he worked on projects for organisations including <strong>Sony Foundation Australia</strong>, <strong>batyr</strong>, <strong>Tranby National Indigenous Adult Education</strong> and <strong>The School of St Jude</strong>.
        </Paragraph>
        <Paragraph>
          The focus is candid photography, alongside speeches, presentations, group photos and the details you need covered.
        </Paragraph>
        <ButtonWrapper marginTop="4">
          <Button element="link" href="/contact">Get in touch</Button>
          <Button element="link" href="/galleries" emphasis="secondary">View Portfolio</Button>
        </ButtonWrapper>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="Meet your photographer"
            text="Speak with Nik about your event and what you want photographed."
          />
          <Card
            heading="People and community"
            text="Share any cultural considerations, permissions or people who should not be photographed."
          />
          <Card
            heading="Plan the coverage"
            text="A schedule and a short list of important photos help us plan the shoot."
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Proof & Experience -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper>
      <Eyebrow variant="tag">TRACK RECORD & REACH</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={26}>
        Events, Projects & Published Photos
      </Heading>
      <Paragraph maxWidth={38}>
        Work across charities, conferences and community events, alongside an open stock photography collection on Unsplash.
      </Paragraph>
    </ContentWrapper>

    <Grid small={1} medium={2} large={4}>
      <Card
        heading="14M+ Views / 53K+ Downloads"
        text="Documentary and commercial imagery featured globally on Unsplash (@nikolasgannon) and licensed across OECD, Australian National University (ANU), BuzzFeed, and Migrant Women Press."
        theme="dark"
      />
      <Card
        heading="Sony Foundation & batyr"
        text="Wharf4Ward charity galas, fundraising events and batyr campaigns."
        theme="dark"
      />
      <Card
        heading="TEDx & Conferences"
        text="Speakers, presentations and backstage photos at TEDx Macquarie Uni and Sydney conferences."
        theme="dark"
      />
      <Card
        heading="Private Celebrations"
        text="Birthdays and engagements, including family photos, speeches and candid moments."
        theme="dark"
      />
    </Grid>

    <LogoBar theme="dark" label="FEATURED & LICENSED GLOBALLY BY" />
  </Section>

  <!-- Production Principles -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper>
      <Eyebrow variant="tag">HOW WE WORK</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Before You Book</Heading>
    </ContentWrapper>

    <Grid small={1} medium={2} large={4}>
      <Card
        heading="1. Your Event"
        text="Tell us the date, location and what you need photographed."
      />
      <Card
        heading="2. Your Quote"
        text="Coverage, cost, delivery timing and photo usage are agreed before booking."
      />
      <Card
        heading="3. The Schedule"
        text="Let us know about speeches, group photos and other moments to plan around."
      />
      <Card
        heading="4. Your Photos"
        text="Tell us how you plan to use the photos and when you need them."
      />
    </Grid>
  </Section>

  <!-- Contact CTA -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">START A CONVERSATION</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Tell Us About Your Event</Heading>
      <Paragraph maxWidth={36}>
        Get in touch about your event, portraits or headshots.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Request a Quote &rarr;</Button>
        <Button element="link" href={`tel:${STUDIO_CONTACT.phoneRaw}`} emphasis="secondary">
          Call {STUDIO_CONTACT.phone}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
