---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import LogoBar from "@/components/Item/LogoBar.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { STUDIO_CONTACT } from "@/consts.ts";
---

<Layout
  title="About Nikolas Gannon & The Studio | Sydney Event Photography"
  description="About Inner West Event Photography, led by Sydney Photographer & Creative Producer Nikolas Gannon. Commercial discipline, authentic client pedigree, and quiet on-site execution."
>
  <!-- Hero -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>ABOUT THE STUDIO</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>Commercial Discipline & Quiet Execution</Heading>
      <Paragraph variant="large" maxWidth={38}>
        Inner West Event Photography is a Sydney photography studio led by Photographer & Creative Producer <strong>Nikolas Gannon</strong>. We provide quiet, dependable photographic documentation for corporate conferences, not-for-profit organisations, brand activations, and campaigns.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Founder Background & Operating Model -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">FOUNDER & LEAD</Eyebrow>
        <Heading tag="h2" variant="h2">Nikolas Gannon</Heading>
        <Paragraph variant="large">
          Photographer & Creative Producer
        </Paragraph>
        <Paragraph>
          Founder Nikolas Gannon brings a grounded background across documentary photography, commercial events, and creative production. Formerly Client Engagement Director at social-impact production agency <em>We Are World Change</em>, Nik delivered campaign assets, live fundraising documentation, and community stories for organisations including <strong>Sony Foundation Australia</strong>, <strong>batyr</strong>, <strong>Tranby National Indigenous Adult Education</strong>, and <strong>The School of St Jude</strong>.
        </Paragraph>
        <Paragraph>
          That dual perspective—as both an accredited photographer on the floor and an experienced producer managing client briefs, run sheets, and stakeholder expectations—informs how Inner West Event Photography operates today: calm communication, disciplined execution under tight run-of-show schedules, and zero translation loss between briefing and final delivery.
        </Paragraph>
        <ButtonWrapper marginTop="4">
          <Button element="link" href="/contact">Discuss an Assignment</Button>
          <Button element="link" href="/galleries" emphasis="secondary">View Portfolio</Button>
        </ButtonWrapper>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="Direct Producer & Lead"
            text="The person you brief is the person who shoots, coordinates on-site logistics, and oversees colour grading, ensuring absolute creative continuity."
          />
          <Card
            heading="Ethical & Dignity-First Approach"
            text="Deep experience in the not-for-profit sector ensures respect, consent-led processes, and discretion with executive VIPs and community participants."
          />
          <Card
            heading="Technical Redundancy"
            text="All assignments are photographed with dual-card full-frame bodies, on-site backup gear, and silent electronic shutters for unobtrusive stage coverage."
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Proof & Experience -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper>
      <Eyebrow variant="tag">TRACK RECORD & REACH</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={26}>
        14M+ Global Views & Proven Sector Experience
      </Heading>
      <Paragraph maxWidth={38}>
        High-visibility documentation and production experience with leading Australian charities, civic institutions, and major corporate events.
      </Paragraph>
    </ContentWrapper>

    <Grid small={1} medium={2} large={4}>
      <Card
        heading="14M+ Views / 53K+ Downloads"
        text="Documentary and commercial imagery featured globally across OECD, Australian National University (ANU), BuzzFeed, and Migrant Women Press."
        theme="dark"
      />
      <Card
        heading="Sony Foundation & batyr"
        text="Flagship Wharf4Ward youth cancer galas, live fundraising auctions, and batyr youth mental health storytelling campaigns."
        theme="dark"
      />
      <Card
        heading="TEDx & Major Summits"
        text="Speaker keynotes, plenary stages, and backstage documentation at TEDx Macquarie Uni and Sydney conference venues."
        theme="dark"
      />
      <Card
        heading="Sub-12h PR Delivery"
        text="Rapid morning-after highlight selects formatted for immediate media distribution, press releases, and social feeds."
        theme="dark"
      />
    </Grid>

    <LogoBar theme="dark" label="FEATURED & LICENSED GLOBALLY BY" />
  </Section>

  <!-- Production Principles -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper>
      <Eyebrow variant="tag">PRODUCTION STANDARDS</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Our Studio Commitments</Heading>
    </ContentWrapper>

    <Grid small={1} medium={2} large={4}>
      <Card
        heading="1. Honest Positioning"
        text="We offer one accountable lead with top-tier collaborator crew assembled strictly when the brief requires it."
      />
      <Card
        heading="2. Transparent Agreements"
        text="Timing, licensing rights, fast PR selects, and deliverables are clearly defined before call time. Zero surprise fees."
      />
      <Card
        heading="3. Studio & Gear Coordination"
        text="We coordinate daylight & cyc studio hire across Sydney, specialized cinema/lighting gear packages, and HMUA upon discussion."
      />
      <Card
        heading="4. Private Cloud Galleries"
        text="Delivered via secure digital portals with unlimited high-resolution downloads, mobile access, and zero watermarks."
      />
    </Grid>
  </Section>

  <!-- Contact CTA -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">START A CONVERSATION</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Let's Discuss Your Upcoming Brief</Heading>
      <Paragraph maxWidth={36}>
        Whether planning a major industry conference or a series of workplace environmental portraits, we're ready to help.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Inquire Now</Button>
        <Button element="link" href={`tel:${STUDIO_CONTACT.phoneRaw}`} emphasis="secondary">
          Call {STUDIO_CONTACT.phone}
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
