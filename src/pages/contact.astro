---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import Form from "@/components/Form/Form.astro";
import Fieldset from "@/components/Form/Fieldset.astro";
import Input from "@/components/Form/Input.astro";
import Select from "@/components/Form/Select.astro";
import Choice from "@/components/Form/Choice.astro";
import Textarea from "@/components/Form/Textarea.astro";
import { STUDIO_CONTACT } from "@/consts.ts";
---

<Layout
  title="Project Inquiry & Booking | Inner West Event Photography"
  description="Contact Inner West Event Photography. Submit your event brief, schedule, run sheet or project scope for a clear, fixed-rate proposal."
>
  <!-- Header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow>PROJECT INQUIRY & BRIEF INTAKE</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}
        >Tell Us About Your Event or Project</Heading
      >
      <Paragraph variant="large" maxWidth={38}>
        Whether you have a confirmed run sheet, an outline schedule, or are just exploring dates and venue availability, share your details below. We reply promptly with a transparent, fixed-rate proposal.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Form & Direct Contact Columns -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentWrapper variant="columns">
      <!-- Left: Form -->
      <div>
        <Form
          name="project-inquiry"
          action={STUDIO_CONTACT.formEndpoint}
          projectId={STUDIO_CONTACT.formProjectId}
          formId={STUDIO_CONTACT.formId}
          enctype="multipart/form-data"
          successMessage="Thanks. Your project brief has been received. We will review your requirements and respond within 24 hours."
        >
          <Fieldset legend="1. Contact Information" variant="columns">
            <Input
              name="fullName"
              label="Full Name"
              placeholder="e.g. Sarah Jenkins"
              required
            />
            <Input
              name="organisation"
              label="Organisation / Company"
              placeholder="e.g. Apex Media Group"
              required
            />
            <Input
              name="email"
              variant="email"
              label="Work Email"
              placeholder="name@company.com.au"
              required
            />
            <Input
              name="phone"
              variant="phone"
              label="Mobile / Phone Number"
              placeholder="+61 400 000 000"
              required
            />
          </Fieldset>

          <Fieldset legend="2. Event Scope & Timing" variant="columns">
            <Select
              name="eventType"
              label="Service / Event Category"
              options={[
                "Corporate Conference or Summit",
                "Awards Gala or Annual Dinner",
                "Not-For-Profit / Community Forum",
                "Brand Launch or Commercial Activation",
                "Staff Headshots & Workplace Portraits",
                "Other Commercial Project",
              ]}
              required
            />
            <Input
              name="eventDate"
              variant="text"
              label="Event Date(s) / Estimated Month"
              placeholder="e.g. 15 November 2026 or Spring 2026"
              required
            />
            <Input
              name="venue"
              label="Venue & Suburb (or Multiple Venues)"
              placeholder="e.g. ICC Sydney, Darling Harbour (or TBC)"
              required
            />
            <Select
              name="coverageHours"
              label="Estimated Hours of Coverage"
              options={[
                "Short Assignment (Up to 2 hours)",
                "Half-Day (Up to 4 hours)",
                "Full-Day (Up to 8 hours)",
                "Multi-Day Summit (2–4 days)",
                "Custom / Flexible Schedule",
              ]}
              required
            />
          </Fieldset>

          <Fieldset
            legend="3. Delivery & Turnaround Speed"
            variant="inline"
            legendStyle="label"
          >
            <Choice
              type="radio"
              name="turnaround"
              label="Standard Master Delivery (3–5 business days)"
              value="standard"
              checked={true}
            />
            <Choice
              type="radio"
              name="turnaround"
              label="Fast PR Selects Required (4–12 hours for press/social)"
              value="fast-pr"
            />
          </Fieldset>

          <Fieldset legend="4. Share Schedule, Run Sheet, or Project Scope">
            <Input
              name="runSheetFile"
              variant="file"
              label="Attach Run Sheet, Schedule, or Brief (Optional: PDF, DOCX, XLSX, PNG, JPG)"
            />
            <Input
              name="runSheetLink"
              variant="url"
              label="Or Share Document Link (Optional: Google Drive, Dropbox, Notion, SharePoint)"
              placeholder="https://docs.google.com/..."
            />
            <Textarea
              name="message"
              label="Event Details, Key Timings, VIPs, or Specific Requirements"
              placeholder="Tell us about your event format, key speakers, sponsor obligations, shot list priorities, or any questions..."
              minLines={4}
            />
          </Fieldset>

          <ButtonWrapper marginTop="4">
            <Button type="submit">Submit Project Brief &rarr;</Button>
          </ButtonWrapper>
        </Form>
      </div>

      <!-- Right: Direct Studio Info & Operational Standards -->
      <div slot="column2">
        <Grid small={1}>
          <Card
            heading="Direct Fast-Track Contact"
            text={`Email: ${STUDIO_CONTACT.email}\nPhone: ${STUDIO_CONTACT.phone}\nWhatsApp: ${STUDIO_CONTACT.whatsappUrl}\nABN: ${STUDIO_CONTACT.abn}`}
          />
          <Card
            heading="Flexible Intake Options"
            text={`• Have a finished run sheet? Attach it above or share a document link.\n• Working to a budget? Let us know your target tier and we will tailor coverage.\n• $10M Public Liability Certificate of Currency provided for all Sydney venues upon booking.`}
          />
          <Card
            heading="Download Briefing Template"
            text="Need a ready-made structure for your internal team? Use our free 4-part priority briefing framework."
            buttonHref="/docs/event-briefing-template"
            buttonLabel="View Template (DOC-01)"
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Helpful Guides for Planning -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">HELPFUL RESOURCES</Eyebrow>
        <Heading tag="h2" variant="h3"
          >Need Help Structuring Your Brief?</Heading
        >
      </div>
      <ButtonWrapper slot="column2">
        <Button element="link" href="/blog#planning-guides" variant="link">
          All guides and articles
        </Button>
      </ButtonWrapper>
    </ContentWrapper>

    <Grid small={1} medium={3}>
      <Card
        heading="Briefing Template"
        text="Use the four-part shot priority checklist for corporate events."
        buttonHref="/docs/event-briefing-template"
        buttonLabel="Read Guide"
        theme="dark"
      />
      <Card
        heading="Sydney Pricing Guide"
        text="Review common day-rate, half-day and licensing structures."
        buttonHref="/docs/pricing-and-rates-guide"
        buttonLabel="Read Guide"
        theme="dark"
      />
      <Card
        heading="Delivery Specifications"
        text="Understand file formats, 300 DPI print masters, and private client portals."
        buttonHref="/docs/turnaround-and-delivery-specs"
        buttonLabel="Read Guide"
        theme="dark"
      />
    </Grid>
  </Section>
</Layout>
