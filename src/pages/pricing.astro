---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import QuoteBuilder from "@/components/Interactive/QuoteBuilder.astro";
import { SITE_URL } from "@/consts.ts";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Pricing",
      item: `${SITE_URL}/pricing`,
    },
  ],
};
---

<Layout
  title="Event Photography Pricing Sydney | IWEP"
  description="See Sydney event photography pricing for corporate, charity, private and workplace events. Build an estimate, then request a confirmed quote."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <!-- Hero Header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow variant="tag">INSTANT EVENT PHOTOGRAPHY ESTIMATE</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>Event Photography Pricing Sydney</Heading>
      <Paragraph variant="large" maxWidth={38}>
        Choose the type of photography and coverage time to see an estimate before sending an enquiry.
      </Paragraph>
      <Paragraph maxWidth={38}>
        We provide clear, upfront pricing for corporate conferences, community and not-for-profit events, private celebrations, workplace headshots, and wedding enquiries across Sydney.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Pricing Builder Tool -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentWrapper>
      <QuoteBuilder id="pricing-builder" />
    </ContentWrapper>
  </Section>

  <!-- How event photography pricing works -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper>
      <Eyebrow variant="tag">PRICING GUIDELINES</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={28}>How event photography pricing works</Heading>
      <Paragraph maxWidth={38}>
        Every booking includes dedicated photographic coverage, professional post-production curation, colour grading, and full commercial reproduction rights for your team in perpetuity.
      </Paragraph>

      <Grid small={1} medium={2} large={3} class="margin-top-4">
        <div>
          <Heading tag="h3" variant="h6">Coverage hours</Heading>
          <Paragraph variant="small">
            Time is calculated continuously on site from the agreed arrival time through to scheduled departure. Continuous coverage ensures speeches, room atmospheres, arrivals, and spontaneous networking are thoroughly documented.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Editing and delivery</Heading>
          <Paragraph variant="small">
            Every image delivered is individually curated, exposure corrected, and colour balanced. Full galleries are delivered in high-resolution and web-optimised formats via private digital download within 3 to 5 business days.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Urgent selects</Heading>
          <Paragraph variant="small">
            Next-day hero highlights or same-day PR selects are available when requested and scoped prior to the event date, ensuring your media outreach and social channels have press-ready images without delay.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">What may change a quote</Heading>
          <Paragraph variant="small">
            Confirmed quotes reflect your specific run sheet. Factors that can adjust an estimate include multiple concurrent rooms, extra photographer requirements, travel outside metropolitan Sydney, or specialised production logistics.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Commercial licensing</Heading>
          <Paragraph variant="small">
            All commercial photography includes full editorial, PR, marketing, annual report, and internal communications rights in perpetuity. There are no surprise licensing fees or recurring usage renewal charges.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">What happens after submission</Heading>
          <Paragraph variant="small">
            Once you submit an estimate through the builder, we review your date, venue, and run sheet details, then return a written confirmed proposal and formal booking agreement within one business day.
          </Paragraph>
        </div>
      </Grid>
    </ContentWrapper>
  </Section>

  <!-- Supporting Guides and Proof -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">REPRESENTATIVE WORK</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={26}>Proven Sydney Event Coverage</Heading>
      <Paragraph maxWidth={36}>
        Explore recent case studies and practical planning guides for conferences, brand activations, and charity galas across Sydney.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/galleries">View Selected Work</Button>
        <Button element="link" href="/docs/pricing-and-rates-guide" variant="link">
          Read Pricing Guide
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
