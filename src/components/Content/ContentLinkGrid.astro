---
import Grid from "@/components/Wrapper/Grid.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Headings, descriptions and links displayed in matching rows. */
  items: { heading: string; text: string; href: string; label: string }[];
}

const { render = true, items } = Astro.props;
---

{render && items.length > 0 && (
  <Grid class="link-grid_wrap">
    {items.map((item) => (
      <div class="link-grid_item">
        <Heading tag="h3" variant="h5" class="link-grid_heading">{item.heading}</Heading>
        <Paragraph class="link-grid_text">{item.text}</Paragraph>
        <ButtonWrapper marginTop="0" class="link-grid_actions">
          <Button element="link" href={item.href} variant="link" class="link-grid_link">
            {item.label}
          </Button>
        </ButtonWrapper>
      </div>
    ))}
  </Grid>
)}

<style is:global>
  @layer components {
    .link-grid_wrap {
      --_alignment: start;
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--space-4);
      text-align: start;

      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .link-grid_item {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      min-width: 0;
      justify-items: start;
      align-items: start;
    }

    .link-grid_item > :is(.link-grid_heading, .link-grid_text) {
      margin: 0;
      text-align: start;
    }

    .link-grid_actions {
      padding-top: var(--space-2);
      padding-bottom: var(--space-6);
      justify-content: flex-start;
    }

    .link-grid_link {
      justify-content: flex-start;
      text-align: start;
    }
  }
</style>
