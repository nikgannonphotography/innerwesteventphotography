---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="content-list">
  {items.map((item) => <li>{item}</li>)}
</ul>

<style is:global>
  @layer components {
    .content-list {
      display: grid;
      gap: var(--space-3);
      margin-top: var(--space-3);
      padding-left: var(--space-5);
    }
  }
</style>
