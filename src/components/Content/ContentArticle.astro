---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"div"> {
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;
const content = await slotContent(Astro.slots);
---

{render && content && (
  <div class:list={["article-body-layout", className]} {...rest}>
    <Fragment set:html={content} />
  </div>
)}

<style is:global>
  @layer components {
    .article-body-layout {
      width: 100%;
      max-width: 70ch;
      margin-inline: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--text);
    }

    .article-intro-block {
      padding-bottom: var(--space-6);
      border-bottom: var(--border-width) solid var(--border);
      font-size: 1.1875rem;
      line-height: 1.7;
    }

    .article-section-block {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .article-section-block h2 {
      margin-top: var(--space-4);
      margin-bottom: var(--space-2);
      line-height: 1.25;
    }

    .article-section-block h3 {
      margin-top: var(--space-3);
      margin-bottom: var(--space-1);
      line-height: 1.3;
      font-size: 1.25rem;
    }

    .article-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin: var(--space-2) 0;
      padding-left: 1.5em;
    }

    .article-list li {
      padding-left: var(--space-1);
      line-height: 1.7;
    }

    .article-list li strong {
      color: var(--text);
      font-weight: 600;
    }

    .article-callout {
      padding: var(--space-5) var(--space-6);
      background-color: var(--background-2);
      border-left: 3px solid var(--brand-500);
      border-radius: var(--radius-small);
      margin-block: var(--space-4);
    }

    .article-callout p {
      font-style: italic;
      line-height: 1.6;
    }

    .article-table-wrap {
      width: 100%;
      overflow-x: auto;
      scrollbar-gutter: stable;
      margin-block: var(--space-5);
      border-radius: var(--radius-small);
      border: var(--border-width) solid var(--border);
    }

    .article-table {
      width: 100%;
      min-width: 36rem;
      border-collapse: collapse;
      font-size: 0.9375rem;
      text-align: left;
    }

    .article-table th {
      background-color: var(--background-2);
      padding: var(--space-3) var(--space-4);
      border-bottom: var(--border-width) solid var(--border);
      font-weight: 600;
      color: var(--text);
    }

    .article-table td {
      padding: var(--space-3) var(--space-4);
      border-bottom: var(--border-width) solid var(--border);
      vertical-align: top;
      line-height: 1.5;
    }

    .article-table tr:last-child td {
      border-bottom: none;
    }

    .article-table .font-bold {
      font-weight: 600;
    }

    .article-faqs-wrap {
      margin-top: var(--space-4);
    }

    .article-conclusion-block {
      padding-top: var(--space-6);
      border-top: var(--border-width) solid var(--border);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      font-size: 1.125rem;
      line-height: 1.7;
    }
  }
</style>
