---
import { Font } from "astro:assets";
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL, STUDIO_CONTACT } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title
  ? title.includes(SITE_NAME)
    ? title
    : `${title} | ${SITE_NAME}`
  : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "PhotographyBusiness",
  name: SITE_NAME,
  alternateName: "IWEP",
  description:
    "Sydney event, conference, not-for-profit, campaign and workplace photography studio.",
  url: SITE_URL,
  telephone: STUDIO_CONTACT.phoneRaw,
  email: STUDIO_CONTACT.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Sydney",
    addressRegion: "NSW",
    addressCountry: "AU",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "-33.8688",
    longitude: "151.2093",
  },
  areaServed: [
    "Sydney",
    "Inner West",
    "Sydney CBD",
    "North Shore",
    "Greater Western Sydney",
  ],
  priceRange: "$$",
};
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-inter" preload />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
