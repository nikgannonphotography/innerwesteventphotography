---
import { Font } from "astro:assets";
import { SITE_NAME, SITE_DESCRIPTION, SITE_URL, STUDIO_CONTACT } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import { SERVICES } from "@/data/services.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title
  ? title.includes(SITE_NAME)
    ? title
    : `${title} | ${SITE_NAME}`
  : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE_URL}/about#nikolas-gannon`,
  name: STUDIO_CONTACT.founder,
  givenName: "Nikolas",
  familyName: "Gannon",
  jobTitle: STUDIO_CONTACT.title,
  worksFor: {
    "@type": "Organization",
    name: SITE_NAME,
    url: SITE_URL,
  },
  url: `${SITE_URL}/about`,
  image: `${SITE_URL}/logos/Square%20Profile%20pic%20IG-FB-LI-X%20-%201080x1080/Square%20Profile%20pic%20IG-FB-LI-X%20-%201080x1080.png`,
  sameAs: [
    STUDIO_CONTACT.linkedinUrl,
    STUDIO_CONTACT.instagramUrl,
    STUDIO_CONTACT.unsplashUrl,
    "https://nikolasgannon.com.au",
  ],
  knowsAbout: [
    "Commercial Event Photography",
    "Corporate Conference Photography",
    "Not-For-Profit & Charity Gala Photography",
    "Brand Activation & Experiential Media",
    "Documentary Visual Production",
  ],
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["PhotographyBusiness", "LocalBusiness"],
  "@id": `${SITE_URL}/#business`,
  name: SITE_NAME,
  legalName: "Inner West Event Photography",
  alternateName: [
    "IWEP",
    "Inner West Event Photography Sydney",
    "Nikolas Gannon Photography",
  ],
  description:
    "Sydney event, corporate conference, not-for-profit gala, brand activation, and workplace headshot photography studio led by Nikolas Gannon.",
  url: SITE_URL,
  logo: `${SITE_URL}/logos/Master%20Logo%20-%205000x5000/Master%20Logo%20-%205000x5000.png`,
  image: `${SITE_URL}/og-image.jpg`,
  telephone: STUDIO_CONTACT.phoneRaw,
  email: STUDIO_CONTACT.email,
  vatID: STUDIO_CONTACT.abn,
  taxID: STUDIO_CONTACT.abn,
  founder: {
    "@type": "Person",
    "@id": `${SITE_URL}/about#nikolas-gannon`,
    name: STUDIO_CONTACT.founder,
    jobTitle: STUDIO_CONTACT.title,
    sameAs: [
      STUDIO_CONTACT.linkedinUrl,
      STUDIO_CONTACT.instagramUrl,
      STUDIO_CONTACT.unsplashUrl,
      "https://nikolasgannon.com.au",
    ],
  },
  employee: [
    {
      "@type": "Person",
      "@id": `${SITE_URL}/about#nikolas-gannon`,
      name: STUDIO_CONTACT.founder,
      jobTitle: STUDIO_CONTACT.title,
    },
  ],
  sameAs: [
    STUDIO_CONTACT.linkedinUrl,
    STUDIO_CONTACT.instagramUrl,
    STUDIO_CONTACT.unsplashUrl,
    "https://nikolasgannon.com.au",
    SITE_URL,
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Sydney",
    addressRegion: "NSW",
    postalCode: "2000",
    addressCountry: "AU",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "-33.8688",
    longitude: "151.2093",
  },
  areaServed: [
    { "@type": "City", name: "Sydney" },
    { "@type": "AdministrativeArea", name: "Inner West Sydney" },
    { "@type": "AdministrativeArea", name: "Sydney CBD" },
    { "@type": "AdministrativeArea", name: "North Shore Sydney" },
    { "@type": "AdministrativeArea", name: "Eastern Suburbs Sydney" },
    { "@type": "AdministrativeArea", name: "Greater Western Sydney" },
  ],
  priceRange: "$$",
  currenciesAccepted: "AUD",
  paymentAccepted: "Invoice, Direct Deposit, Credit Card",
  knowsAbout: [
    "Corporate Event Photography Sydney",
    "Sydney Conference Photography",
    "Not-For-Profit & Charity Gala Photography",
    "Brand Activation & Commercial Photography",
    "Executive Headshots & Workplace Portraits",
    "Documentary Storytelling",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Sydney Photography Services",
    itemListElement: SERVICES.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.tagline,
        url: `${SITE_URL}/services/${service.slug}`,
      },
    })),
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  alternateName: "Inner West Event Photography",
  url: SITE_URL,
};
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="preconnect" href="https://api-ap1.hsforms.net" crossorigin />
<link rel="dns-prefetch" href="https://api-ap1.hsforms.net" />
<Font cssVariable="--font-inter" preload />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="google-site-verification" content="enr_ES9KaYhUCYNcjIAHSVoHEH6HOZgGLcoH3ch3Wzg" />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<meta name="keywords" content="Nikolas Gannon, Nikolas Gannon photographer, Nik Gannon photography, Nikolas Gannon Sydney, Inner West Event Photography Nikolas Gannon, Sydney event photography, corporate event photographer Sydney, conference photography Sydney, not for profit photographer Sydney, Sydney charity gala photography, Inner West event photography, commercial photography Sydney, corporate headshots Sydney" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=2" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
<link rel="icon" type="image/png" href="/favicon.png?v=2" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
<link rel="manifest" href="/site.webmanifest?v=2" />
<meta name="theme-color" content="#ffffff" />
<meta name="apple-mobile-web-app-title" content="IWEP" />
<link rel="shortcut icon" href="/favicon.ico?v=2" />
<link rel="icon" href="/favicon.ico?v=2" />
<meta name="generator" content={Astro.generator} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(localBusinessSchema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
