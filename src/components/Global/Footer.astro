---
import { SITE_NAME, SITE_TAGLINE, STUDIO_CONTACT } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
const links = [
  ["Selected work", "/galleries"],
  ["Services", "/services"],
  ["Guides & articles", "/docs"],
  ["Sydney coverage", "/locations"],
  ["About", "/about"],
  ["Get a quote", "/contact"],
];
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_main">
          <div class="footer_identity">
            <a href="/" aria-label={SITE_NAME}>
              <img
                src="/logos/IWEP - Desktop Website (160 x 40px).png"
                alt={SITE_NAME}
                class="footer_logo"
                width="160"
                height="40"
              />
            </a>
            <p class="footer_desc">{SITE_TAGLINE}</p>
            <div class="footer_contact">
              <a href={`mailto:${STUDIO_CONTACT.email}`}>
                {STUDIO_CONTACT.email}
              </a>
              <a href={`tel:${STUDIO_CONTACT.phoneRaw}`}>
                {STUDIO_CONTACT.phone}
              </a>
            </div>
          </div>
          <nav class="footer_nav" aria-label="Footer">
            {links.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))}
          </nav>
        </div>
        <div class="footer_bottom">
          <p>
            &copy; {new Date().getFullYear()} {SITE_NAME}. ABN{" "}
            {STUDIO_CONTACT.abn}
          </p>
          <div class="footer_legal">
            <a href="/docs/licensing-and-commercial-rights">Licensing rights</a>
            <a href="/docs/pricing-and-rates-guide">Pricing guide</a>
          </div>
        </div>
      </div>
    </footer>
  )
}

<style is:global>
  @layer components {
    .footer_wrap {
      padding: var(--space-5) var(--site-margin);
      background: var(--background);
      color: var(--text-2);
      border-top: var(--border-width) solid var(--border);
      font-size: var(--text-small);
      line-height: 1.4;
      & a {
        text-decoration: none;
        overflow-wrap: anywhere;
        &:hover {
          color: var(--text);
          text-decoration: underline;
          text-underline-offset: 0.2em;
        }
      }
    }
    .footer_inner {
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: grid;
      gap: var(--space-4);
    }
    .footer_main {
      display: grid;
      gap: var(--space-4);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: start;
      }
    }
    .footer_identity {
      display: grid;
      gap: var(--space-2);
    }
    .footer_logo {
      width: 6rem;
      height: auto;
    }
    .footer_desc {
      margin: 0;
    }
    .footer_contact {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-4);
    }
    .footer_nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-1) var(--space-5);
      color: var(--text);
      & a {
        padding-block: 0.25rem;
      }
    }
    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: var(--space-2) var(--space-4);
      font-size: 0.75rem;
      & p {
        margin: 0;
      }
    }
    .footer_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
    }
  }
</style>
