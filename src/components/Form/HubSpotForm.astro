---
interface Props {
  portalId?: string;
  formId?: string;
  region?: string;
}

const {
  portalId = "442724335",
  formId = "6ded9649-fd5b-4bbe-a599-a0fc52b0f74e",
  region = "ap1",
} = Astro.props;
---

<div class="hubspot-form-container">
  <script is:inline src={`https://js-${region}.hsforms.net/forms/embed/${portalId}.js`} defer></script>
  <div
    class="hs-form-frame"
    data-region={region}
    data-form-id={formId}
    data-portal-id={portalId}
  ></div>
</div>

<style is:global>
  @layer components {
    .hubspot-form-container {
      width: 100%;
      min-height: 380px;
    }
  }
</style>
