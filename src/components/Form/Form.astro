---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

interface Props extends HTMLAttributes<"form"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** What the form is called, which is what it submits under. */
  name?: string;
  /** Where it posts. Left unset, it sends nothing and reports success. */
  action?: string;
  /** Formspree CLI project ID. Used with `formId` by the browser client. */
  projectId?: string;
  /** Formspree CLI form key. Used with `projectId` by the browser client. */
  formId?: string;
  /** HubSpot Portal / Hub ID for native CRM submissions. */
  hubspotPortalId?: string;
  /** HubSpot Form GUID for native CRM submissions. */
  hubspotFormId?: string;
  /** HubSpot Region (e.g. ap1, na1, eu1). */
  hubspotRegion?: string;
  /** Shown in place of the fields once it has sent. */
  successMessage?: string;
  /** Shown beneath the fields when it could not send. */
  errorMessage?: string;
}

const {
  render = true,
  name,
  action,
  projectId,
  formId,
  hubspotPortalId,
  hubspotFormId,
  hubspotRegion = "ap1",
  successMessage = "Thanks. We will be in touch.",
  errorMessage = "That did not send. Please try again.",
  method = "post",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && name && content && (
    <div
      class:list={["form_wrap", className]}
      data-state="idle"
      data-endpoint={action}
      data-formspree-project={projectId}
      data-formspree-form={formId}
      data-hubspot-portal={hubspotPortalId}
      data-hubspot-form={hubspotFormId}
      data-hubspot-region={hubspotRegion}
    >
      <form
        class="form_fields"
        name={name}
        action={action}
        method={method}
        {...rest}
      >
        <Fragment set:html={content} />
      </form>

      <p class="form_note form_note-sent text-style-main" role="status">
        {successMessage}
      </p>
      <p class="form_note form_note-failed text-style-main" role="alert">
        {errorMessage}
      </p>
    </div>
  )
}

<script>
  import { createClient, isSubmissionError } from "@formspree/core";

  for (const form of document.querySelectorAll<HTMLElement>(".form_wrap")) {
    const fields = form.querySelector<HTMLFormElement>(".form_fields");
    if (!fields) continue;

    const hubspotPortalId = form.dataset.hubspotPortal;
    const hubspotFormId = form.dataset.hubspotForm;
    const hubspotRegion = form.dataset.hubspotRegion || "ap1";

    if (hubspotPortalId && hubspotFormId) {
      const submit = fields.querySelector<HTMLButtonElement | HTMLInputElement>(
        'button:not([type]), button[type="submit"], input[type="submit"]',
      );

      fields.addEventListener("submit", async (event) => {
        if (!fields.checkValidity()) return;

        event.preventDefault();
        form.dataset.state = "sending";
        if (submit) submit.disabled = true;

        try {
          const formData = new FormData(fields);
          const fullName = String(formData.get("fullName") || "");
          const nameParts = fullName.trim().split(/\s+/);
          const firstname = nameParts[0] || "";
          const lastname = nameParts.slice(1).join(" ") || firstname;

          const email = String(formData.get("email") || "");
          const phone = String(formData.get("phone") || "");
          const company = String(formData.get("organisation") || "");
          const eventType = String(formData.get("eventType") || "");
          const eventDate = String(formData.get("eventDate") || "");
          const venue = String(formData.get("venue") || "");
          const coverageHours = String(formData.get("coverageHours") || "");
          const turnaround = String(formData.get("turnaround") || "");
          const runSheetLink = String(formData.get("runSheetLink") || "");
          const userNotes = String(formData.get("message") || "");
          const runSheetFile = formData.get("runSheetFile");
          let fileNotice = "";
          let hasAttachedFile = false;
          if (
            runSheetFile &&
            typeof runSheetFile === "object" &&
            "name" in runSheetFile &&
            runSheetFile.name &&
            runSheetFile.size > 0
          ) {
            hasAttachedFile = true;
            fileNotice = `Attached File: ${runSheetFile.name} (${(runSheetFile.size / 1024).toFixed(1)} KB)`;
          }

          const combinedMessage = [
            `Event Category: ${eventType}`,
            `Event Date: ${eventDate}`,
            `Venue: ${venue}`,
            `Estimated Hours: ${coverageHours}`,
            `Turnaround Speed: ${turnaround}`,
            runSheetLink ? `Run Sheet / Document Link: ${runSheetLink}` : "",
            fileNotice ? fileNotice : "",
            userNotes ? `\nClient Notes & Scope:\n${userNotes}` : "",
          ]
            .filter(Boolean)
            .join("\n");

          const uploadValue = [runSheetLink, fileNotice].filter(Boolean).join(" | ");

          const hubspotFields = [
            { name: "firstname", value: firstname },
            { name: "lastname", value: lastname },
            { name: "email", value: email },
            { name: "phone", value: phone },
            { name: "company", value: company },
            { name: "message", value: combinedMessage },
          ];

          if (uploadValue) {
            hubspotFields.push({ name: "upload", value: uploadValue });
          }

          const endpoint = `https://api-${hubspotRegion}.hsforms.com/submissions/v3/integration/submit/${hubspotPortalId}/${hubspotFormId}`;

          const response = await fetch(endpoint, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({
              fields: hubspotFields,
              context: {
                pageUri: window.location.href,
                pageName: document.title,
              },
            }),
          });

          if (!response.ok) {
            const fallbackEndpoint = `https://api.hsforms.com/submissions/v3/integration/submit/${hubspotPortalId}/${hubspotFormId}`;
            const fallbackRes = await fetch(fallbackEndpoint, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                fields: hubspotFields,
                context: {
                  pageUri: window.location.href,
                  pageName: document.title,
                },
              }),
            });
            if (!fallbackRes.ok) throw new Error("HubSpot submission failed");
          }

          // If a file was attached and a backup endpoint is configured, send the file binary payload
          const backupEndpoint = form.dataset.endpoint;
          if (hasAttachedFile && backupEndpoint) {
            try {
              await fetch(backupEndpoint, {
                method: "POST",
                body: formData,
                headers: { Accept: "application/json" },
              });
            } catch (err) {
              console.warn("Backup file delivery completed with note in CRM", err);
            }
          }

          form.dataset.state = "sent";
          fields.reset();
        } catch {
          form.dataset.state = "failed";
          if (submit) submit.disabled = false;
        }
      });
      continue;
    }

    const projectId = form.dataset.formspreeProject;
    const formId = form.dataset.formspreeForm;

    if (projectId && formId) {
      const client = createClient({ project: projectId });
      const submit = fields.querySelector<HTMLButtonElement | HTMLInputElement>(
        'button:not([type]), button[type="submit"], input[type="submit"]',
      );

      fields.addEventListener("submit", async (event) => {
        if (!fields.checkValidity()) return;

        event.preventDefault();
        form.dataset.state = "sending";
        if (submit) submit.disabled = true;

        try {
          const answer = await client.submitForm(formId, new FormData(fields), {
            clientName: "iwep-website",
          });
          if (isSubmissionError(answer)) throw new Error("Submission failed");

          form.dataset.state = "sent";
          fields.reset();
        } catch {
          form.dataset.state = "failed";
          if (submit) submit.disabled = false;
        }
      });
      continue;
    }

    const submit = fields.querySelector<HTMLButtonElement | HTMLInputElement>(
      'button:not([type]), button[type="submit"], input[type="submit"]',
    );

    fields.addEventListener("submit", async (event) => {
      const endpoint = form.dataset.endpoint;

      if (!fields.checkValidity()) return;

      event.preventDefault();
      form.dataset.state = "sending";
      if (submit) submit.disabled = true;

      try {
        if (!endpoint) throw new Error("Missing form endpoint");

        const answer = await fetch(endpoint, {
          method: fields.method || "post",
          body: new FormData(fields),
          headers: { Accept: "application/json" },
        });
        if (!answer.ok) throw new Error(String(answer.status));

        form.dataset.state = "sent";
        fields.reset();
      } catch {
        form.dataset.state = "failed";
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

<style is:global>
  @layer components {
    .form_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      width: 100%;
    }

    .form_fields {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      row-gap: var(--space-8);
      column-gap: var(--space-8);
    }

    .form_note {
      display: none;
      padding: var(--space-4) var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
    }

    .form_wrap[data-state="sent"] {
      & .form_fields {
        display: none;
      }
      & .form_note-sent {
        display: block;
      }
    }

    .form_wrap[data-state="failed"] .form_note-failed {
      display: block;
      color: var(--text);
    }
  }
</style>
