---
import type { HTMLAttributes } from "astro/types";
import { HUBSPOT_CONFIG, STUDIO_CONTACT } from "@/consts.ts";
import Button from "@/components/Button.astro";
import Input from "@/components/Form/Input.astro";
import Textarea from "@/components/Form/Textarea.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

interface Props extends HTMLAttributes<"div"> {
  render?: boolean;
}
const { render = true, class: className, ...rest } = Astro.props;
interface CoveragePackage {
  hours: string;
  price: number;
  label: string;
}

const corporatePackages: readonly CoveragePackage[] = [
  { hours: "2-3", price: 450, label: "2-3 hours" },
  { hours: "4-5", price: 700, label: "4-5 hours" },
  { hours: "6-7", price: 1100, label: "6-7 hours" },
  { hours: "8-9", price: 1400, label: "8-9 hours" },
  { hours: "10", price: 1650, label: "10 hours" },
  { hours: "20", price: 3000, label: "Two days (20 hours total)" },
] as const;

const communityPackages: readonly CoveragePackage[] = [
  { hours: "2-3", price: 300, label: "2-3 hours" },
  { hours: "4-5", price: 450, label: "4-5 hours" },
  { hours: "6-7", price: 700, label: "6-7 hours" },
  { hours: "8-9", price: 1100, label: "8-9 hours" },
  { hours: "10", price: 1500, label: "10 hours" },
  { hours: "20", price: 2800, label: "Two days (20 hours max)" },
] as const;

const privatePackages: readonly CoveragePackage[] = [
  { hours: "2", price: 350, label: "2 hours" },
  { hours: "4-5", price: 500, label: "4-5 hours" },
  { hours: "6-7", price: 750, label: "6-7 hours" },
  { hours: "8-9", price: 1000, label: "8-9 hours" },
  { hours: "10", price: 1200, label: "10 hours" },
] as const;
---

{
  render && (
    <div class:list={["pricing-form", className]} {...rest}>
      <form
        id="pricing-form"
        action={STUDIO_CONTACT.formEndpoint}
        method="post"
        data-hubspot-portal={HUBSPOT_CONFIG.portalId}
        data-hubspot-form={HUBSPOT_CONFIG.formId}
        data-hubspot-region={HUBSPOT_CONFIG.region}
      >
        <section
          class="pricing-form_step"
          aria-labelledby="pricing-type-heading"
        >
          <div class="pricing-form_step-heading">
            <>
              <span class="pricing-form_number">1</span>
              <div class="pricing-form_step-copy">
                <Heading tag="h2" variant="h4" id="pricing-type-heading">
                  What do you need photographed?
                </Heading>
                <Paragraph>
                  Choose the closest option. Add any details below.
                </Paragraph>
              </div>
            </>
          </div>
          <div class="pricing-form_choices pricing-form_choices-types">
            <label class="pricing-form_choice">
              <>
                <input
                  type="radio"
                  name="photographyType"
                  value="corporate"
                  required
                />
                <span>Corporate events</span>
              </>
            </label>
            <label class="pricing-form_choice">
              <>
                <input
                  type="radio"
                  name="photographyType"
                  value="community"
                  required
                />
                <span>Not-for-profit and community events</span>
              </>
            </label>
            <label class="pricing-form_choice">
              <>
                <input
                  type="radio"
                  name="photographyType"
                  value="private"
                  required
                />
                <span>Private celebrations</span>
              </>
            </label>
            <label class="pricing-form_choice">
              <>
                <input
                  type="radio"
                  name="photographyType"
                  value="headshots"
                  required
                />
                <span>Workplace headshots</span>
              </>
            </label>
            <label class="pricing-form_choice">
              <>
                <input
                  type="radio"
                  name="photographyType"
                  value="wedding"
                  required
                />
                <span>Weddings and elopements</span>
              </>
            </label>
          </div>
        </section>

        <section
          class="pricing-form_step"
          id="pricing-options"
          aria-labelledby="pricing-options-heading"
          hidden
        >
          <div class="pricing-form_step-heading">
            <>
              <span class="pricing-form_number">2</span>
              <div class="pricing-form_step-copy">
                <Heading tag="h2" variant="h4" id="pricing-options-heading">
                  Choose your coverage
                </Heading>
                <Paragraph id="pricing-options-intro">
                  Select a coverage block.
                </Paragraph>
              </div>
            </>
          </div>

          <div id="corporate-pricing" class="pricing-form_packages" hidden>
            <div class="pricing-form_choices pricing-form_choices-prices">
              {corporatePackages.map((pkg) => (
                <label class="pricing-form_choice pricing-form_price-choice">
                  <input
                    type="radio"
                    name="coveragePackage"
                    value={pkg.hours}
                    data-label={pkg.label}
                    data-price={String(pkg.price)}
                  />
                  <span>
                    <strong>{pkg.label}</strong>
                    <small>${pkg.price.toLocaleString("en-AU")}</small>
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div id="community-pricing" class="pricing-form_packages" hidden>
            <div class="pricing-form_choices pricing-form_choices-prices">
              {communityPackages.map((pkg) => (
                <label class="pricing-form_choice pricing-form_price-choice">
                  <input
                    type="radio"
                    name="coveragePackage"
                    value={pkg.hours}
                    data-label={pkg.label}
                    data-price={String(pkg.price)}
                  />
                  <span>
                    <strong>{pkg.label}</strong>
                    <small>${pkg.price.toLocaleString("en-AU")}</small>
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div id="private-pricing" class="pricing-form_packages" hidden>
            <div class="pricing-form_choices pricing-form_choices-prices">
              {privatePackages.map((pkg) => (
                <label class="pricing-form_choice pricing-form_price-choice">
                  <input
                    type="radio"
                    name="coveragePackage"
                    value={pkg.hours}
                    data-label={pkg.label}
                    data-price={String(pkg.price)}
                  />
                  <span>
                    <strong>{pkg.label}</strong>
                    <small>${pkg.price.toLocaleString("en-AU")}</small>
                  </span>
                </label>
              ))}
            </div>
          </div>

          <div id="extra-hours-panel" hidden>
            <label
              class="pricing-form_field pricing-form_extra-hours"
              for="extra-hours"
            >
              <>
                <span class="field-label text-style-main">Extra hours</span>
                <small class="pricing-form_help">
                  Add time beyond the selected block at $175 per hour.
                </small>
              </>
              <input
                id="extra-hours"
                name="extraHours"
                type="number"
                min="0"
                step="1"
                value="0"
                inputmode="numeric"
                class="field-control text-style-main"
              />
            </label>
          </div>

          <div id="headshot-pricing" class="pricing-form_panel" hidden>
            <label class="pricing-form_field" for="team-size">
              <span class="field-label text-style-main">
                How many people need headshots?
              </span>
              <small class="pricing-form_help">
                Individuals from $120 (including 3 edited headshots). Teams of 3 to 5 are $450.
                Six to nine staff is $110 each. Teams of 10 or more are quoted after discussion.
              </small>
              <input
                id="team-size"
                name="teamSize"
                type="number"
                min="1"
                step="1"
                inputmode="numeric"
                class="field-control text-style-main"
              />
            </label>
          </div>
          <div id="wedding-pricing" class="pricing-form_panel" hidden>
            <Paragraph>
              Wedding coverage is priced after a discussion about the date,
              locations, hours and run sheet.
            </Paragraph>
          </div>
          <div
            id="pricing-summary"
            class="pricing-form_summary"
            aria-live="polite"
            hidden
          >
            <span class="pricing-form_summary-label">
              Estimated photography fee
            </span>
            <>
              <strong id="pricing-total" />
              <p id="pricing-summary-text" />
            </>
          </div>
        </section>

        <section
          class="pricing-form_step"
          id="pricing-details"
          aria-labelledby="pricing-details-heading"
          hidden
        >
          <div class="pricing-form_step-heading">
            <>
              <span class="pricing-form_number">3</span>
              <div class="pricing-form_step-copy">
                <Heading tag="h2" variant="h4" id="pricing-details-heading">
                  Tell me about the job
                </Heading>
                <Paragraph>
                  Share what you know. Venue and organisation are optional.
                </Paragraph>
              </div>
            </>
          </div>
          <input
            type="hidden"
            name="eventType"
            id="pricing-event-type"
            value=""
          />
          <input
            type="hidden"
            name="coverageHours"
            id="pricing-coverage-hours"
            value=""
          />
          <input
            type="hidden"
            name="estimatedTotal"
            id="pricing-estimated-total"
            value=""
          />
          <input
            type="hidden"
            name="calculatedQuoteSummary"
            id="pricing-quote-summary"
            value=""
          />
          <div class="pricing-form_fields">
            <Input label="Name" name="fullName" autocomplete="name" required />
            <Input label="Email" name="email" variant="email" required />
            <Input label="Phone" name="phone" variant="phone" required />
            <Input
              label="Company or organisation"
              name="organisation"
              autocomplete="organization"
            />
            <Input
              label="Date"
              name="eventDate"
              placeholder="Date or TBC"
              required
            />
            <Input label="Venue or suburb" name="venue" />
            <Textarea
              class="pricing-form_field-wide"
              label="Project details"
              name="message"
              minLines={5}
              placeholder="Event times, location, what you need photographed, and anything else that will help."
            />
          </div>
          <div class="pricing-form_submit-row">
            <Button type="submit" id="pricing-submit">
              Request a Quote
            </Button>
            <Paragraph variant="small">
              No payment is taken through this form.
            </Paragraph>
          </div>
          <p
            class="pricing-form_status"
            id="pricing-success"
            role="status"
            hidden
          >
            Thanks. Your enquiry has been sent. I’ll check the details and get
            back to you.
          </p>
          <p class="pricing-form_status" id="pricing-error" role="alert" hidden>
            That did not send. Email{" "}
            <a href={`mailto:${STUDIO_CONTACT.email}`}>
              {STUDIO_CONTACT.email}
            </a>{" "}
            or call{" "}
            <a href={`tel:${STUDIO_CONTACT.phoneRaw}`}>
              {STUDIO_CONTACT.phone}
            </a>
            .
          </p>
        </section>
      </form>
    </div>
  )
}

<script>
  const typeLabels: Record<string, string> = {
    corporate: "Corporate event",
    community: "Not-for-profit or community event",
    private: "Private celebration",
    headshots: "Workplace headshots",
    wedding: "Wedding or elopement",
  };

  function initPricingForm() {
    const form = document.querySelector<HTMLFormElement>("#pricing-form");
    if (!form || form.dataset.ready === "true") return;
    form.dataset.ready = "true";
    const find = <T extends Element>(selector: string) =>
      form.querySelector<T>(selector);
    const options = find<HTMLElement>("#pricing-options");
    const details = find<HTMLElement>("#pricing-details");
    const corporatePricing = find<HTMLElement>("#corporate-pricing");
    const communityPricing = find<HTMLElement>("#community-pricing");
    const privatePricing = find<HTMLElement>("#private-pricing");
    const extraHoursPanel = find<HTMLElement>("#extra-hours-panel");
    const headshotPricing = find<HTMLElement>("#headshot-pricing");
    const weddingPricing = find<HTMLElement>("#wedding-pricing");
    const intro = find<HTMLElement>("#pricing-options-intro");
    const summary = find<HTMLElement>("#pricing-summary");
    const total = find<HTMLElement>("#pricing-total");
    const summaryText = find<HTMLElement>("#pricing-summary-text");
    const extraHours = find<HTMLInputElement>("#extra-hours");
    const teamSize = find<HTMLInputElement>("#team-size");
    const hiddenType = find<HTMLInputElement>("#pricing-event-type");
    const hiddenHours = find<HTMLInputElement>("#pricing-coverage-hours");
    const hiddenTotal = find<HTMLInputElement>("#pricing-estimated-total");
    const hiddenSummary = find<HTMLInputElement>("#pricing-quote-summary");
    const submit = find<HTMLButtonElement>("#pricing-submit");
    const success = find<HTMLElement>("#pricing-success");
    const error = find<HTMLElement>("#pricing-error");
    const selectedType = () =>
      find<HTMLInputElement>('input[name="photographyType"]:checked')?.value ||
      "";
    const selectedPackage = () =>
      find<HTMLInputElement>('input[name="coveragePackage"]:checked');

    function clearCoverage() {
      for (const input of document.querySelectorAll<HTMLInputElement>(
        '#pricing-form input[name="coveragePackage"]',
      ))
        input.checked = false;
      if (extraHours) extraHours.value = "0";
      if (teamSize) teamSize.value = "";
    }
    function writeSummary(
      label: string,
      description: string,
      fee: string,
      hours = "",
    ) {
      if (total) total.textContent = fee;
      if (summaryText) summaryText.textContent = description;
      if (summary) summary.hidden = false;
      if (details) details.hidden = false;
      if (hiddenType) hiddenType.value = label;
      if (hiddenHours) hiddenHours.value = hours;
      if (hiddenTotal) hiddenTotal.value = fee;
      if (hiddenSummary)
        hiddenSummary.value = `${label}\n${description}\nEstimated photography fee: ${fee}`;
    }
    function hideSummary() {
      if (summary) summary.hidden = true;
      if (details) details.hidden = true;
      if (hiddenHours) hiddenHours.value = "";
      if (hiddenTotal) hiddenTotal.value = "";
      if (hiddenSummary) hiddenSummary.value = "";
    }
    function calculate() {
      const type = selectedType();
      const label = typeLabels[type] || "Photography enquiry";
      if (["corporate", "community", "private"].includes(type)) {
        const coverage = selectedPackage();
        if (!coverage) return hideSummary();
        const packageLabel = coverage.dataset.label || coverage.value;
        const basePrice = Number(coverage.dataset.price || 0);
        const addedHours = Math.max(0, Number(extraHours?.value || 0));
        const price = basePrice + addedHours * 175;
        const extraLabel = addedHours
          ? ` plus ${addedHours} extra ${addedHours === 1 ? "hour" : "hours"}`
          : "";
        const note =
          type === "corporate" && coverage.value === "20"
            ? "Review the run sheet before confirming two-day work. Final scope is confirmed before booking."
            : "Final scope is confirmed before booking.";
        writeSummary(
          label,
          `${packageLabel}${extraLabel}. ${note}`,
          `$${price.toLocaleString("en-AU")}`,
          addedHours > 0 ? `${packageLabel} + ${addedHours}h extra` : packageLabel,
        );
        return;
      }
      if (type === "headshots") {
        const count = Math.max(0, Number(teamSize?.value || 0));
        if (!count) return hideSummary();
        if (count >= 10)
          return writeSummary(
            label,
            `${count} people. Quoted after discussion. Two finished headshots per person included.`,
            "Priced after discussion",
            `${count} people`,
          );
        let price = 450;
        let description = "";
        if (count === 1) {
          price = 120;
          description = "1 person. Three edited headshots included.";
        } else if (count === 2) {
          price = 240;
          description = "2 people. Three edited headshots each included.";
        } else if (count <= 5) {
          price = 450;
          description = `${count} people. Small team base with edited headshots included.`;
        } else {
          price = count * 110;
          description = `${count} people at $110 per person. Two finished headshots per person included.`;
        }
        writeSummary(
          label,
          `${description} Final scope is confirmed before booking.`,
          `$${price.toLocaleString("en-AU")}`,
          `${count} people`,
        );
        return;
      }
      if (type === "wedding")
        writeSummary(
          label,
          "Price confirmed after discussing the date, locations, hours and run sheet.",
          "Priced after discussion",
        );
    }

    form.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === "photographyType") {
        clearCoverage();
        const type = target.value;
        if (options) options.hidden = false;
        if (corporatePricing) corporatePricing.hidden = type !== "corporate";
        if (communityPricing) communityPricing.hidden = type !== "community";
        if (privatePricing) privatePricing.hidden = type !== "private";
        if (extraHoursPanel)
          extraHoursPanel.hidden = !["corporate", "community", "private"].includes(
            type,
          );
        if (headshotPricing) headshotPricing.hidden = type !== "headshots";
        if (weddingPricing) weddingPricing.hidden = type !== "wedding";
        if (intro)
          intro.textContent =
            type === "headshots"
              ? "Enter the team size."
              : type === "wedding"
                ? "Wedding pricing is confirmed after a short discussion."
                : "Select a coverage block. Extra time is $175 per hour.";
        hideSummary();
        calculate();
      } else calculate();
    });
    form.addEventListener("input", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.id === "extra-hours" || target.id === "team-size") calculate();
    });

    for (const input of form.querySelectorAll<HTMLInputElement>(
      'input[type="text"], input[type="email"], input[type="tel"]',
    )) {
      input.addEventListener("blur", () => {
        input.value = input.value.trim();
      });
    }

    form.addEventListener("submit", async (event) => {
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      event.preventDefault();
      if (submit) {
        submit.disabled = true;
        submit.textContent = "Sending...";
      }
      if (success) success.hidden = true;
      if (error) error.hidden = true;
      const formData = new FormData(form);
      const fullName = String(formData.get("fullName") || "").trim();
      const parts = fullName.split(/\s+/);
      const email = String(formData.get("email") || "").trim().toLowerCase();
      const phone = String(formData.get("phone") || "").trim();
      const company = String(formData.get("organisation") || "").trim();
      const eventDate = String(formData.get("eventDate") || "").trim();
      const venue = String(formData.get("venue") || "").trim();
      const userMessage = String(formData.get("message") || "").trim();

      const photographyType = String(formData.get("eventType") || "");
      const selectedPkg = selectedPackage();
      const coverageLabel =
        selectedPkg?.dataset.label ||
        String(formData.get("coveragePackage") || "");
      const extraHoursSelected = String(formData.get("extraHours") || "0");
      const teamSizeSelected = String(formData.get("teamSize") || "");
      const estimatedTotal = String(formData.get("estimatedTotal") || "");
      const selectionNote = [
        "Website pricing tool selection",
        `Photography type: ${photographyType}`,
        coverageLabel ? `Coverage block: ${coverageLabel}` : "",
        Number(extraHoursSelected) > 0 ? `Extra hours: ${extraHoursSelected}` : "",
        teamSizeSelected ? `Team size: ${teamSizeSelected} people` : "",
        `Estimate shown: ${estimatedTotal}`,
      ]
        .filter(Boolean)
        .join("\n");
      const message = [
        selectionNote,
        `Event date: ${eventDate || "Not supplied"}`,
        `Venue or suburb: ${venue || "Not supplied"}`,
        userMessage ? `Client notes:\n${userMessage}` : "",
      ]
        .filter(Boolean)
        .join("\n\n");
      try {
        let sent = false;
        const portal = form.dataset.hubspotPortal;
        const formId = form.dataset.hubspotForm;
        const region = form.dataset.hubspotRegion || "ap1";
        if (portal && formId) {
          const response = await fetch(
            `https://api-${region}.hsforms.com/submissions/v3/integration/submit/${portal}/${formId}`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                fields: [
                  { name: "firstname", value: parts[0] || "" },
                  {
                    name: "lastname",
                    value: parts.slice(1).join(" ") || parts[0] || "",
                  },
                  { name: "email", value: email },
                  { name: "phone", value: phone },
                  {
                    name: "company",
                    value: company,
                  },
                  { name: "message", value: message },
                ],
                context: {
                  pageUri: window.location.href,
                  pageName: document.title,
                },
              }),
            },
          );
          sent = response.ok;
        }
        if (!sent && form.action) {
          const response = await fetch(form.action, {
            method: "POST",
            body: formData,
            headers: { Accept: "application/json" },
          });
          sent = response.ok;
        }
        if (!sent) throw new Error("Submission failed");
        if (success) success.hidden = false;
        if (submit) submit.textContent = "Quote requested";
        form.reset();
        if (options) options.hidden = true;
        hideSummary();
      } catch {
        if (error) error.hidden = false;
        if (submit) {
          submit.disabled = false;
          submit.textContent = "Request a Quote";
        }
      }
    });
  }
  if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", initPricingForm);
  else initPricingForm();
  document.addEventListener("astro:page-load", initPricingForm);
</script>

<style is:global>
  @layer components {
    .pricing-form {
      max-width: 64rem;
      margin-inline: auto;
    }
    .pricing-form [hidden] {
      display: none !important;
    }
    .pricing-form_step {
      padding-block: var(--space-8);
      border-top: var(--border-width) solid var(--border);
    }
    .pricing-form_step-heading {
      display: grid;
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-3);
      align-items: start;
      margin-bottom: var(--space-6);
    }
    .pricing-form_step-copy {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      max-width: 42rem;
    }
    .pricing-form_step-copy > * {
      margin: 0;
    }
    .pricing-form_step-copy .text {
      color: var(--text-2);
    }
    .pricing-form_number {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border: var(--border-width) solid var(--border);
      border-radius: 50%;
      font-weight: 700;
    }
    .pricing-form_choices {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }
    .pricing-form_choices-types .pricing-form_choice:last-child {
      grid-column: 1 / -1;
    }
    .pricing-form_choice {
      position: relative;
      display: block;
      cursor: pointer;
    }
    .pricing-form_choice input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }
    .pricing-form_choice > span {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 5.5rem;
      padding: var(--space-4);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background: var(--background-2);
      transition:
        background var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
    }
    @media (hover: hover) {
      .pricing-form_choice:hover > span {
        border-color: var(--text-2);
      }
    }
    .pricing-form_choice input:checked + span {
      color: var(--background);
      background: var(--dark-900);
      border-color: var(--dark-900);
    }
    .pricing-form_choice input:focus-visible + span {
      outline: 0.125rem solid var(--text);
      outline-offset: 0.1875rem;
    }
