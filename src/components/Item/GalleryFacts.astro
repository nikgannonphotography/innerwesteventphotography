---
interface Props {
  coverage: string;
  location: string;
  year: string;
}

const { coverage, location, year } = Astro.props;
---

<dl class="gallery-facts">
  <div>
    <dt>Coverage</dt>
    <dd>{coverage}</dd>
  </div>
  {
    location && (
      <div>
        <dt>Location</dt>
        <dd>{location}</dd>
      </div>
    )
  }
  <div>
    <dt>Year</dt>
    <dd>{year}</dd>
  </div>
</dl>

<style is:global>
  @layer components {
    .gallery-facts {
      display: grid;
      gap: var(--space-3);
      margin: 0;
    }

    .gallery-facts > div {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: var(--space-3);
    }

    .gallery-facts dt {
      margin-bottom: 0;
      color: var(--text-2);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: var(--letter-spacing-normal);
    }

    .gallery-facts dd {
      margin: 0;
    }
  }
</style>
