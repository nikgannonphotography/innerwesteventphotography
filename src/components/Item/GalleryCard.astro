---
import type { HTMLAttributes } from "astro/types";
import Img from "@/components/Media/Img.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  title: string;
  meta: string;
  image: string;
  featured?: boolean;
}

const {
  href,
  title,
  meta,
  image,
  featured = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  class:list={["gallery-card", featured && "featured", className]}
  href={href}
  {...rest}
>
  <div class="gallery-card_visual">
    <Img
      src={image}
      alt=""
      width={1200}
      height={800}
      loading={featured ? "eager" : "lazy"}
      fetchPriority={featured ? "high" : "auto"}
    />
  </div>
  <div class="gallery-card_content">
    <Heading tag="h3" variant="h5">{title}</Heading>
    <Paragraph>{meta}</Paragraph>
  </div>
</a>

<style is:global>
  @layer components {
    .gallery-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      color: inherit;
      text-decoration: none;
    }

    .gallery-card_visual {
      position: relative;
      aspect-ratio: 3 / 2;
      overflow: hidden;
      border-radius: var(--radius-main);
      background: var(--background-2);
    }

    .gallery-card_visual .image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: scale calc(var(--hover-duration) * 2) var(--hover-ease);
    }

    .gallery-card_content {
      display: grid;
      gap: var(--space-2);
    }

    .gallery-card_content :is(h3, p) {
      margin: 0;
    }

    @media (width >= 48rem) {
      .gallery-card.featured {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
        gap: var(--site-gutter);
        align-items: center;
      }

      .gallery-card.featured .gallery-card_content {
        padding-right: var(--space-6);
      }
    }

    @media (hover: hover) {
      .gallery-card:hover .gallery-card_visual .image {
        scale: 1.03;
      }

      .gallery-card:hover h3 {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }
    }
  }
</style>
